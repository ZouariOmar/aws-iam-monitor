#!/usr/bin/env bash
# =========================================
# FILE
#   lib/requirements
#
# SYNOPSIS
#   Prerequisite validation for aws-iam-monitor scripts.
#
# DESCRIPTION
#   Checks that required system commands are present
#   before any AWS operations are attempted.
#
#   check_command    Silently verify a single command is installed.
#   check_requirements
#                    Verify a list of commands; exit on first missing.
#
# USAGE
#   source lib/requirements
#   check_requirements aws jq zip openssl
#
# NOTES
#   Project     : aws-iam-monitor
#   Version     : 2.0
#   Author      : @ZouariOmar (zouariomar20@gmail.com)
#   Created     : 08/07/2026
#   Updated     : 03/08/2026
# =========================================
set -Eeuo pipefail

# ---------------------------------------------------------------------------
# check_command COMMAND
#
# Returns 0 if COMMAND is on PATH; exits 1 with an error message if not.
# ---------------------------------------------------------------------------
check_command() {
  local cmd="$1"

  if ! command -v "$cmd" &>/dev/null; then
    msg ERROR "Required command not found: '$cmd'"
    msg INFO "Install '$cmd' and re-run"
    exit 1
  fi
}

# ---------------------------------------------------------------------------
# check_requirements COMMAND [COMMAND...]
#
# Verify that every listed command is available.
# Exits on the first missing dependency.
# ---------------------------------------------------------------------------
check_requirements() {
  msg INFO "Checking prerequisites..."

  local cmd
  for cmd in "$@"; do
    check_command "$cmd"
  done

  msg SUCCESS "All prerequisites satisfied: $*"
}
