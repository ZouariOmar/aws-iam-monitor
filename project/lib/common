#!/usr/bin/env bash
# =========================================
# .FILE
#   common
#
# .SYNOPSIS
#   Common utility functions for IAM automation scripts
#
# .DESCRIPTION
#   Provides shared helper functions used by IAMSentinel
#   lifecycle scripts.
#
#   This library contains reusable functions for script
#   loading, validation, and common runtime operations.
#
#   This script is part of IAMSentinel, a real-time AWS IAM
#   auditing and monitoring project.
#
# .INPUTS
#   Script paths passed to utility functions.
#
# .OUTPUTS
#   Provides reusable shell functions to calling scripts.
#
# .NOTES
#   Project       : aws-iam-monitor
#   Version       : 1.0
#   Author        : @ZouariOmar (zouariomar20@gmail.com)
#   Created       : 14/07/2026
#   Change Log    : 1.0 Initial release
#
# .EXAMPLE
#   load_script "lib/logger"
#
# .REQUIREMENTS
#   - Bash
#   - Logger module loaded before using msg()
#
# shellcheck disable=SC1090
# =========================================
set -Eeuo pipefail

#####################
### CONFIGURATION ###
#####################

# Global vars
VERBOSE=${VERBOSE:-false}

######################
### !CONFIGURATION ###
######################

load_script() {
  local SCRIPT="$1"

  if [[ -s "$SCRIPT" ]]; then
    . "$SCRIPT"

    if [[ "$VERBOSE" == true ]]; then
      msg SUCCESS "'$SCRIPT' Loaded successfully!"
    fi

  else
    msg ERROR "Missing Script: '$SCRIPT'"
    exit 1
  fi
}

check_script() {
  local SCRIPT="$1"

  if [[ -z "$SCRIPT" ]]; then
    msg ERROR "Script path is empty."
    exit 1
  fi

  if [[ ! -f "$SCRIPT" ]]; then
    msg ERROR "Script not found: '$SCRIPT'"
    exit 1
  fi

  if [[ ! -x "$SCRIPT" ]]; then
    msg ERROR "Script is not executable: '$SCRIPT'"
    msg INFO "Run: chmod u+x '$SCRIPT'"
    exit 1
  fi
}

run_script() {
  local SCRIPT="$1"
  shift

  check_script "$SCRIPT"

  if [[ "$VERBOSE" == true ]]; then
    msg INFO "Running: ${SCRIPT}"
  fi

  "$SCRIPT" "$@"

  local STATUS=$?

  if [[ $STATUS -ne 0 ]]; then
    msg ERROR "Script failed: '${SCRIPT}' (exit code: ${STATUS})"
    exit "$STATUS"
  fi
}

require_variable() {
  local NAME="$1"

  if [[ -z "${!NAME:-}" ]]; then
    msg ERROR "Required variable '$NAME' is not set"
    exit 1
  fi
}

load_env() {
  if [[ $# -eq 0 ]]; then
    msg ERROR "No environment file(s) specified"
    exit 1
  fi

  for ENV_FILE in "$@"; do
    if [[ ! -f "$ENV_FILE" ]]; then
      msg WARNING "Environment file not found: ${ENV_FILE}"
      continue
    fi

    msg INFO "Loading environment file: ${ENV_FILE}"

    set -a
    source "$ENV_FILE"
    set +a
  done
}
