#!/usr/bin/env bash
# =========================================
# FILE
#   event-bridge/test/rule_metrics
#
# SYNOPSIS
#   Test script to trigger an IAM event and verify EventBridge rule metrics.
# =========================================
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${LIB_DIR:-${SCRIPT_DIR}/../../lib}"

RULE_NAME="${RULE_NAME:-aws-iam-monitor-rule}"
TEST_USER="${TEST_USER:-eventbridge-test-user-$(date +%s)}"
AWS_REGION="${AWS_REGION:-$(aws configure get region 2>/dev/null || echo 'us-east-1')}"
WAIT_SECONDS="${WAIT_SECONDS:-120}"

if [[ -s "${LIB_DIR}/common" ]]; then
  # shellcheck disable=SC1091
  . "${LIB_DIR}/common"
else
  echo "[ERROR] Missing: ${LIB_DIR}/common" >&2
  exit 1
fi
load_script "${LIB_DIR}/logger"

# shellcheck disable=SC2329
cleanup() {
  msg INFO "Cleaning up test user '${TEST_USER}'..."
  if aws iam get-user --user-name "$TEST_USER" &>/dev/null; then
    aws iam delete-user --user-name "$TEST_USER" &>/dev/null
    msg SUCCESS "Deleted test user: ${TEST_USER}"
  fi
}
trap cleanup EXIT

msg INFO "Creating test IAM user: ${TEST_USER}"
aws iam create-user --user-name "$TEST_USER" >/dev/null
msg SUCCESS "Test IAM user created"

for ((seconds_left = WAIT_SECONDS; seconds_left > 0; seconds_left--)); do
  printf "\r%b[INFO]%b Waiting %2ds for CloudTrail/EventBridge propagation..." "$_LOG_BLUE" "$_LOG_RESET" "$seconds_left"
  sleep 1
done
printf "\n"

msg INFO "Querying CloudWatch MatchedEvents metric..."
START_TIME=$(date -u -d "10 minutes ago" +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date -u +"%Y-%m-%dT%H:%M:%SZ")
END_TIME=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

MATCHED_EVENTS=$(aws cloudwatch get-metric-statistics \
  --namespace AWS/Events \
  --metric-name MatchedEvents \
  --dimensions Name=RuleName,Value="$RULE_NAME" \
  --statistics Sum \
  --period 300 \
  --start-time "$START_TIME" \
  --end-time "$END_TIME" \
  --region "$AWS_REGION" \
  --output json 2>/dev/null |
  jq '[.Datapoints[].Sum] | add // 0' || echo "0")

msg SUCCESS "EventBridge test workflow completed (MatchedEvents: ${MATCHED_EVENTS})"
exit 0
