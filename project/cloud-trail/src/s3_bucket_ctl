#!/usr/bin/env bash
# =========================================
# .FILE
#   s3_bucket_ctl
#
# .SYNOPSIS
#   AWS S3 bucket management automation
#   script.
#
# .DESCRIPTION
#   Creates, configures, monitors, and
#   removes an Amazon S3 bucket.
#
#   The script:
#     - Creates an S3 bucket
#     - Enables default server-side
#       encryption
#     - Configures the S3 bucket policy
#     - Displays bucket status
#     - Removes all bucket objects
#     - Deletes the S3 bucket
#
#   Designed to provision and manage
#   S3 buckets used by other project
#   components such as AWS CloudTrail.
#
# .USAGE
#   ./s3_bucket_ctl [OPTIONS] ACTION
#
# .ACTIONS
#   --up
#       Create and configure the S3 bucket.
#
#   --down
#       Delete the S3 bucket and all
#       bucket objects.
#
#   --status
#       Display S3 bucket status.
#
# .OPTIONS
#   --bucket-name <name>
#       Name of the S3 bucket.
#
#   --aws-account-id <id>
#       AWS account ID used when
#       configuring the bucket policy.
#
#   --aws-region <region>
#       AWS region where the bucket
#       resides.
#
#   --bucket-encryption-sse-algorithm <algorithm>
#       Default server-side encryption
#       algorithm.
#       Default:
#         AES256
#
#   -v, --verbose
#       Enable verbose output.
#
#   -h, --help
#       Display this help message.
#
# .INPUTS
#   Command-line arguments.
#
# .OUTPUTS
#   --up:
#       Configured S3 bucket.
#
#   --status:
#       S3 bucket status information.
#
#   --down:
#       Deleted S3 bucket.
#
# .FILES
#   policies/cloud-trail/
#       bucket-policy.json
#       bucket-encryption.json
#
# .NOTES
#   Project       : aws-iam-monitor
#   Version       : 1.0
#   Author        : @ZouariOmar
#   Created       : 2026-07-20
#
# .REQUIREMENTS
#   - AWS CLI v2
#   - Configured AWS credentials
#   - IAM permissions:
#       s3:*
# =========================================
set -Eeuo pipefail

#####################
### Configuration ###
#####################

# Directories
LIB_DIR="${LIB_DIR:-lib}"
CLOUD_TRAIL_DIR="${CLOUD_TRAIL_DIR:-cloud-trail}"
CLOUD_TRAIL_POLICIES_DIR="${CLOUD_TRAIL_POLICIES_DIR:-${CLOUD_TRAIL_DIR}/policies}"

# Files
BUCKET_POLICY_FILE="${CLOUD_TRAIL_POLICIES_DIR}/bucket-policy.json"
BUCKET_ENCRYPTION_FILE="${CLOUD_TRAIL_POLICIES_DIR}/bucket-encryption.json"

# Global vars
VERBOSE=${VERBOSE:-false}

# AWS vars
AWS_ACCOUNT_ID=${AWS_ACCOUNT_ID:-}
AWS_REGION=${AWS_REGION:-}

# S3 vars
BUCKET_ENCRYPTION_SSE_ALGORITHM=${BUCKET_ENCRYPTION_SSE_ALGORITHM:-"AES256"}
BUCKET_NAME=${BUCKET_NAME:-}

######################
### !Configuration ###
######################

usage() {
  cat <<EOF
$(msg "USAGE:")
  $(basename "$0") [OPTIONS] ACTION

$(msg "ACTIONS:")
  --up
      Create and configure the S3 bucket.

  --down
      Delete the S3 bucket and all bucket objects.

  --status
      Display S3 bucket status.

$(msg "OPTIONS:")
  --bucket-name <name>
      Name of the S3 bucket.

  --aws-account-id <id>
      AWS account ID used when configuring
      the bucket policy.

  --aws-region <region>
      AWS region where the bucket resides.

  --bucket-encryption-sse-algorithm <algorithm>
      Default server-side encryption algorithm.
      Default:
        AES256

  -v, --verbose
      Enable verbose output.

  -h, --help
      Display this help message.

$(msg "EXAMPLES:")
  Create an S3 bucket:
    $(basename "$0") \\
      --bucket-name aws-cloudtrail-logs-123456789012 \\
      --aws-account-id 123456789012 \\
      --aws-region us-east-1 \\
      --up

  Check bucket status:
    $(basename "$0") \\
      --bucket-name aws-cloudtrail-logs-123456789012 \\
      --aws-region us-east-1 \\
      --status

  Delete the S3 bucket:
    $(basename "$0") \\
      --bucket-name aws-cloudtrail-logs-123456789012 \\
      --down
EOF
}

create_s3_bucket() {
  msg INFO "Creating S3 Bucket..."

  if aws s3api head-bucket \
    --bucket "${BUCKET_NAME}" >/dev/null 2>&1; then
    msg INFO "Bucket already exists"

  else
    msg INFO "Creating CloudTrail S3 bucket"

    aws s3api create-bucket \
      --bucket "${BUCKET_NAME}" \
      --region "${AWS_REGION}" >/dev/null

    msg SUCCESS "Bucket created"
  fi

  # Enable bucket encryption
  msg INFO "Enabling S3 encryption"

  aws s3api put-bucket-encryption \
    --bucket "${BUCKET_NAME}" \
    --server-side-encryption-configuration "$(
      sed "s/{{BUCKET_ENCRYPTION_SSE_ALGORITHM}}/${BUCKET_ENCRYPTION_SSE_ALGORITHM}/g" \
        "$BUCKET_ENCRYPTION_FILE"
    )" >/dev/null

  # Add bucket policy
  msg INFO "Configuring bucket policy"

  if aws s3api get-bucket-policy \
    --bucket "${BUCKET_NAME}" >/dev/null 2>&1; then
    msg INFO "Bucket policy already exists"

  else
    msg INFO "Putting bucket policy"

    aws s3api put-bucket-policy \
      --bucket "${BUCKET_NAME}" \
      --policy "$(
        sed \
          -e "s/{{AWS_ACCOUNT_ID}}/${AWS_ACCOUNT_ID}/g" \
          -e "s/{{BUCKET_NAME}}/${BUCKET_NAME}/g" \
          "$BUCKET_POLICY_FILE"
      )" || {
      msg ERROR "Failed creating bucket policy"
      exit 1
    }

    msg SUCCESS "Bucket policy created successfully"
  fi
}

delete_s3_bucket() {
  msg INFO "Deleting S3 bucket..."

  if aws s3api head-bucket \
    --bucket "${BUCKET_NAME}" >/dev/null 2>&1; then

    # Remove bucket policy
    msg INFO "Removing bucket policy"

    if aws s3api get-bucket-policy \
      --bucket "${BUCKET_NAME}" >/dev/null 2>&1; then

      aws s3api delete-bucket-policy \
        --bucket "${BUCKET_NAME}" >/dev/null

      msg SUCCESS "Bucket policy removed"

    else
      msg INFO "Bucket policy does not exist"
    fi

    # Remove encryption
    msg INFO "Removing bucket encryption"

    if aws s3api get-bucket-encryption \
      --bucket "${BUCKET_NAME}" >/dev/null 2>&1; then

      aws s3api delete-bucket-encryption \
        --bucket "${BUCKET_NAME}" >/dev/null

      msg SUCCESS "Bucket encryption removed"

    else
      msg INFO "Bucket encryption does not exist"
    fi

    # Delete objects
    msg INFO "Deleting bucket objects"

    aws s3 rm \
      "s3://${BUCKET_NAME}" \
      --recursive >/dev/null

    msg SUCCESS "Bucket objects removed"

    # Delete bucket
    aws s3api delete-bucket \
      --bucket "${BUCKET_NAME}"

    msg SUCCESS "S3 bucket deleted successfully"

  else
    msg INFO "S3 bucket does not exist"
  fi
}

s3_bucket_status() {
  msg INFO "Checking S3 bucket..."

  if ! aws s3api head-bucket \
    --bucket "${BUCKET_NAME}" >/dev/null 2>&1; then
    msg ERROR "S3 bucket '${BUCKET_NAME}' does not exist"
    return 1
  fi

  msg SUCCESS "S3 bucket exists"

  msg INFO "Bucket location:"
  aws s3api get-bucket-location \
    --bucket "${BUCKET_NAME}"

  msg INFO "Default encryption:"
  if ! aws s3api get-bucket-encryption \
    --bucket "${BUCKET_NAME}"; then
    msg INFO "No default bucket encryption configured"
  fi

  msg INFO "Bucket policy:"
  if ! aws s3api get-bucket-policy \
    --bucket "${BUCKET_NAME}"; then
    msg INFO "No bucket policy configured"
  fi
}

main() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --aws-account-id)
      AWS_ACCOUNT_ID="$2"
      require_variable AWS_ACCOUNT_ID
      shift 2
      ;;

    --bucket-encryption-sse-algorithm)
      BUCKET_ENCRYPTION_SSE_ALGORITHM="$2"
      require_variable BUCKET_ENCRYPTION_SSE_ALGORITHM
      shift 2
      ;;

    --aws-region)
      AWS_REGION="$2"
      require_variable AWS_REGION
      shift 2
      ;;

    --bucket-name)
      BUCKET_NAME="$2"
      require_variable BUCKET_NAME
      shift 2
      ;;

    -v | --verbose)
      VERBOSE=true
      shift
      ;;

    --up | --down | --status)
      ACTION="$1"
      shift
      ;;

    -h | --help)
      usage
      ;;

    *)
      msg ERROR "Unknown option: $1"
      usage
      ;;
    esac
  done

  case "${ACTION:-}" in
  --up)
    create_s3_bucket
    ;;

  --down)
    delete_s3_bucket
    ;;

  --status)
    s3_bucket_status
    ;;

  *)
    msg ERROR "Missing action (--up/--down)"
    usage
    ;;
  esac
}

# Load scripts
if [[ -s "${LIB_DIR}/common" ]]; then
  # shellcheck disable=SC1091
  . "${LIB_DIR}/common"
else
  echo "[ERROR] Missing Script: '${LIB_DIR}/common'"
  exit 1
fi
load_script "${LIB_DIR}/logger"

main "$@"
