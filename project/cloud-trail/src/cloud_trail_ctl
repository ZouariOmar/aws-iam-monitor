#!/usr/bin/env bash
# =========================================
# FILE
#   cloud-trail/src/cloud_trail_ctl
#
# SYNOPSIS
#   AWS CloudTrail lifecycle management.
#
# DESCRIPTION
#   Creates, configures, monitors, and removes an AWS CloudTrail
#   trail for monitoring IAM API activity across an AWS account.
#
#   Delegates S3 log bucket provisioning and cleanup to s3_bucket_ctl.
#
#   Lifecycle operations:
#     --up      Provision the S3 log bucket via s3_bucket_ctl,
#               create the trail (idempotent), configure management
#               event selectors, and start logging.
#     --down    Stop trail logging, delete the trail, and delete
#               the S3 log bucket via s3_bucket_ctl.
#     --status  Report status of the trail and the S3 log bucket.
#
# USAGE
#   ./cloud_trail_ctl --up   --aws-account-id <id> --aws-region <region> [OPTIONS]
#   ./cloud_trail_ctl --down --aws-account-id <id> [OPTIONS]
#   ./cloud_trail_ctl --status --aws-account-id <id> --aws-region <region> [OPTIONS]
#
# OPTIONS
#   --up | --down | --status            Lifecycle action (required).
#   --aws-account-id <id>               AWS account ID (required).
#   --aws-region   <region>             AWS region (required).
#   --trail-name   <name>               CloudTrail trail name.
#                                       Default: aws-iam-monitor-management-events
#   --event-selectors-rw-type <type>    Management event read/write filtering:
#                                       All (default), ReadOnly, WriteOnly.
#   --bucket-encryption-sse-algorithm   S3 encryption algorithm (default: AES256).
#   -v, --verbose                       Enable verbose execution output.
#   -h, --help                          Show this help.
#
# EXAMPLES
#   Create CloudTrail environment:
#     ./cloud_trail_ctl --up \
#       --aws-account-id 123456789012 \
#       --aws-region us-east-1
#
#   Check status:
#     ./cloud_trail_ctl --status \
#       --aws-account-id 123456789012 \
#       --aws-region us-east-1
#
#   Delete CloudTrail environment:
#     ./cloud_trail_ctl --down \
#       --aws-account-id 123456789012 \
#       --aws-region us-east-1
#
# DEPENDENCIES
#   AWS CLI v2, s3_bucket_ctl, sed
#
# REQUIRED IAM PERMISSIONS
#   cloudtrail:CreateTrail       cloudtrail:DeleteTrail
#   cloudtrail:DescribeTrails     cloudtrail:StartLogging
#   cloudtrail:StopLogging        cloudtrail:GetTrailStatus
#   cloudtrail:PutEventSelectors cloudtrail:GetEventSelectors
#   (Plus S3 permissions via s3_bucket_ctl)
#
# EXIT CODES
#   0   Success
#   1   Error
#
# NOTES
#   Project     : aws-iam-monitor
#   Version     : 2.0
#   Author      : @ZouariOmar (zouariomar20@gmail.com)
#   Created     : 20/07/2026
#   Updated     : 03/08/2026
#
# shellcheck disable=SC1090,SC1091
# =========================================
set -Eeuo pipefail

#####################
### CONFIGURATION ###
#####################

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${LIB_DIR:-${SCRIPT_DIR}/../../lib}"

CLOUD_TRAIL_POLICIES_DIR="${SCRIPT_DIR}/../policies"
S3_BUCKET_CTL="${SCRIPT_DIR}/s3_bucket_ctl"
TRAIL_EVENT_SELECTORS_FILE="${CLOUD_TRAIL_POLICIES_DIR}/event-selectors.json"

# Defaults.
AWS_ACCOUNT_ID=""
AWS_REGION=""
TRAIL_NAME="aws-iam-monitor-management-events"
TRAIL_EVENT_SELECTOR_READ_WRITE_TYPE="All"
TRAIL_BUCKET_ENCRYPTION_SSE_ALGORITHM="AES256"
TRAIL_BUCKET_NAME=""
ACTION=""
VERBOSE="${VERBOSE:-false}"

######################
### !CONFIGURATION ###
######################

usage() {
  cat <<EOF
$(msg "USAGE:")

  $(basename "$0") <--up|--down|--status> --aws-account-id <id> \\
                            --aws-region <region> [OPTIONS]


$(msg "ACTIONS:")

  --up
      Create S3 bucket, create CloudTrail trail, configure event
      selectors, and start logging.

  --down
      Stop logging, delete CloudTrail trail, and delete S3 bucket.

  --status
      Display CloudTrail trail status and event selectors.


$(msg "OPTIONS:")

  --aws-account-id <id>               AWS account ID.
  --aws-region   <region>             AWS region.
  --trail-name   <name>               Trail name (default: aws-iam-monitor-management-events).
  --event-selectors-rw-type <type>    Read/Write mode: All (default), ReadOnly, WriteOnly.
  --bucket-encryption-sse-algorithm   SSE algorithm (default: AES256).
  -v, --verbose                       Enable verbose execution logs.
  -h, --help                          Show this help message.


$(msg "EXAMPLES:")

  Create trail:
    $(basename "$0") --up --aws-account-id 123456789012 --aws-region us-east-1

  Check status:
    $(basename "$0") --status --aws-account-id 123456789012 --aws-region us-east-1

  Delete trail:
    $(basename "$0") --down --aws-account-id 123456789012 --aws-region us-east-1
EOF
  exit 1
}

# ---------------------------------------------------------------------------
# create_trail
# ---------------------------------------------------------------------------
create_trail() {
  msg INFO "Creating CloudTrail trail: $TRAIL_NAME"

  # Provision S3 log bucket.
  local args=()
  [[ "${VERBOSE:-false}" == true ]] && args+=(--verbose)

  run_script "$S3_BUCKET_CTL" --up \
    --aws-account-id "$AWS_ACCOUNT_ID" \
    --aws-region "$AWS_REGION" \
    --bucket-name "$TRAIL_BUCKET_NAME" \
    --bucket-encryption-sse-algorithm "$TRAIL_BUCKET_ENCRYPTION_SSE_ALGORITHM" \
    "${args[@]}"

  # Check if trail exists.
  local exists
  exists=$(aws cloudtrail describe-trails \
    --trail-name-list "$TRAIL_NAME" \
    --region "$AWS_REGION" \
    --query "trailList[?Name=='${TRAIL_NAME}'].Name" \
    --output text 2>/dev/null || echo "")

  if [[ -n "$exists" ]]; then
    msg INFO "CloudTrail trail already exists: $TRAIL_NAME"
  else
    local err
    if ! err=$(aws cloudtrail create-trail \
      --name "$TRAIL_NAME" \
      --s3-bucket-name "$TRAIL_BUCKET_NAME" \
      --region "$AWS_REGION" \
      --output json 2>&1); then
      msg ERROR "Failed to create CloudTrail trail '$TRAIL_NAME'"
      [[ "${VERBOSE:-false}" == true ]] && msg DEBUG "$err"
      exit 1
    fi

    msg SUCCESS "CloudTrail trail created: $TRAIL_NAME"
  fi

  # Configure Event Selectors.
  if [[ -f "$TRAIL_EVENT_SELECTORS_FILE" ]]; then
    msg INFO "Configuring management event selectors (${TRAIL_EVENT_SELECTOR_READ_WRITE_TYPE})..."
    local selectors
    selectors=$(sed "s/{{TRAIL_EVENT_SELECTOR_READ_WRITE_TYPE}}/${TRAIL_EVENT_SELECTOR_READ_WRITE_TYPE}/g" \
      "$TRAIL_EVENT_SELECTORS_FILE")

    aws cloudtrail put-event-selectors \
      --trail-name "$TRAIL_NAME" \
      --region "$AWS_REGION" \
      --event-selectors "$selectors" >/dev/null

    msg SUCCESS "Event selectors configured"
  fi

  # Start Logging.
  msg INFO "Starting CloudTrail logging..."
  aws cloudtrail start-logging \
    --name "$TRAIL_NAME" \
    --region "$AWS_REGION" >/dev/null

  msg SUCCESS "CloudTrail logging started"
}

# ---------------------------------------------------------------------------
# delete_trail
# ---------------------------------------------------------------------------
delete_trail() {
  msg INFO "Deleting CloudTrail trail: $TRAIL_NAME"

  local exists
  exists=$(aws cloudtrail describe-trails \
    --trail-name-list "$TRAIL_NAME" \
    --region "$AWS_REGION" \
    --query "trailList[?Name=='${TRAIL_NAME}'].Name" \
    --output text 2>/dev/null || echo "")

  if [[ -n "$exists" ]]; then
    # Stop logging.
    msg INFO "Stopping CloudTrail logging..."
    aws cloudtrail stop-logging \
      --name "$TRAIL_NAME" \
      --region "$AWS_REGION" >/dev/null 2>&1 || true

    # Delete trail.
    aws cloudtrail delete-trail \
      --name "$TRAIL_NAME" \
      --region "$AWS_REGION" >/dev/null

    msg SUCCESS "CloudTrail trail deleted: $TRAIL_NAME"
  else
    msg INFO "CloudTrail trail does not exist — skipping trail deletion"
  fi

  # Teardown S3 log bucket.
  local args=()
  [[ "${VERBOSE:-false}" == true ]] && args+=(--verbose)

  run_script "$S3_BUCKET_CTL" --down \
    --bucket-name "$TRAIL_BUCKET_NAME" \
    "${args[@]}"
}

# ---------------------------------------------------------------------------
# trail_status
# ---------------------------------------------------------------------------
trail_status() {
  msg INFO "Checking CloudTrail status: $TRAIL_NAME"

  # S3 bucket status.
  local args=()
  [[ "${VERBOSE:-false}" == true ]] && args+=(--verbose)

  "$S3_BUCKET_CTL" --status \
    --bucket-name "$TRAIL_BUCKET_NAME" \
    "${args[@]}" || true

  local exists
  exists=$(aws cloudtrail describe-trails \
    --trail-name-list "$TRAIL_NAME" \
    --region "$AWS_REGION" \
    --query "trailList[?Name=='${TRAIL_NAME}'].Name" \
    --output text 2>/dev/null || echo "")

  if [[ -z "$exists" ]]; then
    msg WARNING "CloudTrail trail '$TRAIL_NAME' does not exist"
    return 0
  fi

  msg SUCCESS "CloudTrail trail exists: $TRAIL_NAME"

  msg INFO "Trail Status:"
  aws cloudtrail get-trail-status \
    --name "$TRAIL_NAME" \
    --region "$AWS_REGION" \
    --output json

  msg INFO "Event Selectors:"
  aws cloudtrail get-event-selectors \
    --trail-name "$TRAIL_NAME" \
    --region "$AWS_REGION" \
    --output json
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------
main() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --up | --down | --status)
      ACTION="$1"
      shift
      ;;
    --aws-account-id)
      AWS_ACCOUNT_ID="$2"
      shift 2
      ;;
    --aws-region)
      AWS_REGION="$2"
      shift 2
      ;;
    --trail-name)
      TRAIL_NAME="$2"
      shift 2
      ;;
    --event-selectors-rw-type)
      TRAIL_EVENT_SELECTOR_READ_WRITE_TYPE="$2"
      shift 2
      ;;
    --bucket-encryption-sse-algorithm)
      TRAIL_BUCKET_ENCRYPTION_SSE_ALGORITHM="$2"
      shift 2
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      ;;
    *)
      msg ERROR "Unknown option: $1"
      usage
      ;;
    esac
  done

  require_variable AWS_ACCOUNT_ID
  require_variable AWS_REGION

  TRAIL_BUCKET_NAME="${TRAIL_BUCKET_NAME:-aws-cloudtrail-logs-${AWS_ACCOUNT_ID}-${AWS_REGION}}"

  case "${ACTION:-}" in
  --up) create_trail ;;
  --down) delete_trail ;;
  --status) trail_status ;;
  *)
    msg ERROR "Action required: --up, --down, or --status"
    usage
    ;;
  esac

  msg "========================================================================================================="
  msg INFO "CloudTrail Console...https://${AWS_REGION}.console.aws.amazon.com/cloudtrailv2/home?region=${AWS_REGION}#/trails"
  msg INFO "Trail Name...........${TRAIL_NAME}"
  msg INFO "S3 Bucket............${TRAIL_BUCKET_NAME}"
  msg INFO "Region...............${AWS_REGION}"
  msg INFO "AWS Account..........${AWS_ACCOUNT_ID}"
  msg "========================================================================================================="
}

