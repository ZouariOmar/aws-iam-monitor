#!/usr/bin/env bash
# =========================================
# FILE
#   iam/src/iamctl
#
# SYNOPSIS
#   AWS IAM environment lifecycle orchestrator.
#
# DESCRIPTION
#   Unified CLI for managing the complete IAM environment
#   lifecycle used by aws-iam-monitor.
#
#   Orchestrates four IAM management modules:
#     policy_ctl   — Customer-managed IAM policies
#     group_ctl    — IAM groups with policy attachments
#     user_ctl     — IAM users with group membership
#     role_ctl     — IAM roles with trust policies (optional)
#
#   Resource definitions are read from CSV files in res/:
#     groups.csv   FORMAT: group,policy
#     users.csv    FORMAT: user,group
#     roles.csv    FORMAT: service,role,policy,trust_policy
#
#   Setup order (--up):
#     1. Policies (required by groups)
#     2. Groups   (required by users)
#     3. Users
#     4. Roles    (optional, enabled with --role)
#
#   Teardown order (--down):
#     1. Users
#     2. Roles    (optional)
#     3. Groups
#     4. Policies
#
# USAGE
#   ./iamctl --up   [OPTIONS]
#   ./iamctl --down [OPTIONS]
#   ./iamctl --status [OPTIONS]
#
# OPTIONS
#   --up | --down | --status  Lifecycle action (required).
#   --aws-account-id <id>     AWS account ID (required).
#   --role                    Enable IAM role management.
#   -v, --verbose             Enable verbose output.
#   -h, --help                Show this help.
#
# EXAMPLES
#   Create IAM environment:
#     ./iamctl --up --aws-account-id 123456789012
#
#   Create with roles:
#     ./iamctl --up --aws-account-id 123456789012 --role
#
#   Remove IAM environment:
#     ./iamctl --down --aws-account-id 123456789012
#
#   Check status:
#     ./iamctl --status --aws-account-id 123456789012
#
# DEPENDENCIES
#   AWS CLI v2, policy_ctl, group_ctl, user_ctl, role_ctl
#
# REQUIRED IAM PERMISSIONS
#   See individual sub-scripts for required permissions.
#
# EXIT CODES
#   0   Success
#   1   Error
#
# NOTES
#   Project     : aws-iam-monitor
#   Version     : 2.0
#   Author      : @ZouariOmar (zouariomar20@gmail.com)
#   Created     : 14/07/2026
#   Updated     : 03/08/2026
#
# shellcheck disable=SC1090,SC1091
# =========================================
set -Eeuo pipefail

#####################
### CONFIGURATION ###
#####################

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${LIB_DIR:-${SCRIPT_DIR}/../../lib}"

# Sub-scripts (resolved from this script's location).
POLICY_CTL="${SCRIPT_DIR}/policy_ctl"
GROUP_CTL="${SCRIPT_DIR}/group_ctl"
USER_CTL="${SCRIPT_DIR}/user_ctl"
ROLE_CTL="${SCRIPT_DIR}/role_ctl"

# Resource files.
IAM_POLICIES_DIR="${SCRIPT_DIR}/../policies"
IAM_RES_DIR="${SCRIPT_DIR}/../res"
IAM_GROUPS_FILE="${IAM_RES_DIR}/groups.csv"
IAM_USERS_FILE="${IAM_RES_DIR}/users.csv"
IAM_ROLES_FILE="${IAM_RES_DIR}/roles.csv"

# Defaults.
AWS_ACCOUNT_ID=""
ACTION=""
ENABLE_ROLES=false
VERBOSE="${VERBOSE:-false}"

######################
### !CONFIGURATION ###
######################

usage() {
  cat <<EOF
$(msg "USAGE:")

  $(basename "$0") <--up|--down|--status> --aws-account-id <id> [OPTIONS]


$(msg "ACTIONS:")

  --up
      Create the IAM environment.

      Order: Policies → Groups → Users → Roles (optional)

  --down
      Remove the IAM environment.

      Order: Users → Roles (optional) → Groups → Policies

  --status
      Report existence of all IAM resources.


$(msg "OPTIONS:")

  --aws-account-id <id>   AWS account ID.
  --role                  Enable IAM role management.
  -v, --verbose           Enable verbose output.
  -h, --help              Show this help.


$(msg "RESOURCE FILES:")

  res/groups.csv    Group-to-policy mappings.   FORMAT: group,policy
  res/users.csv     User-to-group mappings.     FORMAT: user,group
  res/roles.csv     Role definitions.            FORMAT: service,role,policy,trust_policy


$(msg "EXAMPLES:")

  Create environment:
    $(basename "$0") --up --aws-account-id 123456789012

  Create with roles:
    $(basename "$0") --up --aws-account-id 123456789012 --role

  Remove environment:
    $(basename "$0") --down --aws-account-id 123456789012

  Check status:
    $(basename "$0") --status --aws-account-id 123456789012
EOF
  exit 1
}

# ---------------------------------------------------------------------------
# iam_up  — create policies, groups, users, optionally roles.
# ---------------------------------------------------------------------------
iam_up() {
  msg INFO "Starting IAM setup..."

  local args=()
  [[ "${VERBOSE:-false}" == true ]] && args+=(--verbose)

  # 1. Policies and Groups (from groups.csv: group,policy).
  while IFS=',' read -r group policy; do
    # Strip leading/trailing whitespace.
    group="${group// /}"
    policy="${policy// /}"

    [[ -z "$group" || -z "$policy" ]] && continue

    [[ "${VERBOSE:-false}" == true ]] && msg DEBUG "Group: $group | Policy: $policy"

    run_script "$POLICY_CTL" --up \
      --policy-name "$policy" \
      --policy-dir "$IAM_POLICIES_DIR" \
      --aws-account-id "$AWS_ACCOUNT_ID" \
      "${args[@]}"

    run_script "$GROUP_CTL" --up \
      --group-name "$group" \
      --policy-name "$policy" \
      --aws-account-id "$AWS_ACCOUNT_ID" \
      "${args[@]}"

  done < <(tail -n +2 "$IAM_GROUPS_FILE")

  # 2. Users (from users.csv: user,group).
  while IFS=',' read -r user group; do
    user="${user// /}"
    group="${group// /}"

    [[ -z "$user" || -z "$group" ]] && continue

    [[ "${VERBOSE:-false}" == true ]] && msg DEBUG "User: $user | Group: $group"

    run_script "$USER_CTL" --up \
      --user "$user" \
      --group "$group" \
      "${args[@]}"

  done < <(tail -n +2 "$IAM_USERS_FILE")

  # 3. Roles (optional — from roles.csv: service,role,policy,trust_policy).
  if [[ "${ENABLE_ROLES:-false}" == true ]]; then
    while IFS=',' read -r service role policy trust_policy; do
      service="${service// /}"
      role="${role// /}"
      policy="${policy// /}"
      trust_policy="${trust_policy// /}"

      [[ -z "$role" || -z "$policy" ]] && continue

      [[ "${VERBOSE:-false}" == true ]] && msg DEBUG "Role: $role | Policy: $policy | Service: $service"

      # Resolve trust policy path based on the service directory.
      local trust_policy_path
      case "$service" in
      iam) trust_policy_path="${IAM_POLICIES_DIR}/${trust_policy}" ;;
      lambda) trust_policy_path="${SCRIPT_DIR}/../../lambda/policies/${trust_policy}" ;;
      *) trust_policy_path="${IAM_POLICIES_DIR}/${trust_policy}" ;;
      esac

      run_script "$ROLE_CTL" --up \
        --role-name "$role" \
        --policy-name "$policy" \
        --trust-policy "$trust_policy_path" \
        --aws-account-id "$AWS_ACCOUNT_ID" \
        "${args[@]}"

    done < <(tail -n +2 "$IAM_ROLES_FILE")
  fi

  msg SUCCESS "IAM setup complete"
}

# ---------------------------------------------------------------------------
# iam_down  — delete users, optionally roles, groups, policies.
# ---------------------------------------------------------------------------
iam_down() {
  msg INFO "Starting IAM teardown..."

  local args=()
  [[ "${VERBOSE:-false}" == true ]] && args+=(--verbose)

  # 1. Users first (from users.csv: user,group).
  while IFS=',' read -r user group; do
    user="${user// /}"
    group="${group// /}"

    [[ -z "$user" || -z "$group" ]] && continue

    run_script "$USER_CTL" --down \
      --user "$user" \
      --group "$group" \
      "${args[@]}"

  done < <(tail -n +2 "$IAM_USERS_FILE")

  # 2. Roles (optional).
  if [[ "${ENABLE_ROLES:-false}" == true ]]; then
    while IFS=',' read -r _service role _policy _trust; do
      role="${role// /}"
      [[ -z "$role" ]] && continue

      run_script "$ROLE_CTL" --down \
        --role-name "$role" \
        --aws-account-id "$AWS_ACCOUNT_ID" \
        "${args[@]}"

    done < <(tail -n +2 "$IAM_ROLES_FILE")
  fi

  # 3. Groups (from groups.csv: group,policy).
  while IFS=',' read -r group _policy; do
    group="${group// /}"
    [[ -z "$group" ]] && continue

    run_script "$GROUP_CTL" --down \
      --group-name "$group" \
      --aws-account-id "$AWS_ACCOUNT_ID" \
      "${args[@]}"

  done < <(tail -n +2 "$IAM_GROUPS_FILE")

  # 4. Policies.
  while IFS=',' read -r _group policy; do
    policy="${policy// /}"
    [[ -z "$policy" ]] && continue

    run_script "$POLICY_CTL" --down \
      --policy-name "$policy" \
      --aws-account-id "$AWS_ACCOUNT_ID" \
      "${args[@]}"

  done < <(tail -n +2 "$IAM_GROUPS_FILE")

  msg SUCCESS "IAM teardown complete"
}

# ---------------------------------------------------------------------------
# iam_status  — report existence of all resources.
# ---------------------------------------------------------------------------
iam_status() {
  msg INFO "Checking IAM resource status..."
  local any_missing=false

  # Policies.
  while IFS=',' read -r _group policy; do
    policy="${policy// /}"
    [[ -z "$policy" ]] && continue
    local arn
    arn=$(build_arn iam "" "$AWS_ACCOUNT_ID" "policy/${policy}")
    if aws iam get-policy --policy-arn "$arn" &>/dev/null; then
      msg SUCCESS "Policy exists: $policy"
    else
      msg ERROR "Policy missing: $policy"
      any_missing=true
    fi
  done < <(tail -n +2 "$IAM_GROUPS_FILE")

  # Groups.
  while IFS=',' read -r group _policy; do
    group="${group// /}"
    [[ -z "$group" ]] && continue
    if aws iam get-group --group-name "$group" &>/dev/null; then
      msg SUCCESS "Group exists: $group"
    else
      msg ERROR "Group missing: $group"
      any_missing=true
    fi
  done < <(tail -n +2 "$IAM_GROUPS_FILE")

  # Users.
  while IFS=',' read -r user _group; do
    user="${user// /}"
    [[ -z "$user" ]] && continue
    if aws iam get-user --user-name "$user" &>/dev/null; then
      msg SUCCESS "User exists: $user"
    else
      msg ERROR "User missing: $user"
      any_missing=true
    fi
  done < <(tail -n +2 "$IAM_USERS_FILE")

  # Roles (optional).
  if [[ "${ENABLE_ROLES:-false}" == true ]]; then
    while IFS=',' read -r _service role _policy _trust; do
      role="${role// /}"
      [[ -z "$role" ]] && continue
      if aws iam get-role --role-name "$role" &>/dev/null; then
        msg SUCCESS "Role exists: $role"
      else
        msg ERROR "Role missing: $role"
        any_missing=true
      fi
    done < <(tail -n +2 "$IAM_ROLES_FILE")
  fi

  if [[ "$any_missing" == true ]]; then
    msg WARNING "Some IAM resources are missing"
    return 1
  fi

  msg SUCCESS "All IAM resources are present"
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------
main() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --up | --down | --status)
      ACTION="$1"
      shift
      ;;
    --aws-account-id)
      AWS_ACCOUNT_ID="$2"
      shift 2
      ;;
    --role)
      ENABLE_ROLES=true
      shift
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      ;;
    *)
      msg ERROR "Unknown option: $1"
      usage
      ;;
    esac
  done

  require_variable AWS_ACCOUNT_ID

  case "${ACTION:-}" in
  --up) iam_up ;;
  --down) iam_down ;;
  --status) iam_status ;;
  *)
    msg ERROR "Action required: --up, --down, or --status"
    usage
    ;;
  esac

  msg "========================================================================"
  msg INFO "IAM Console.....https://console.aws.amazon.com/iam/home"
  msg INFO "Users...........https://console.aws.amazon.com/iam/home#/users"
  msg INFO "Groups..........https://console.aws.amazon.com/iam/home#/groups"
  msg INFO "Roles...........https://console.aws.amazon.com/iam/home#/roles"
  msg INFO "Policies........https://console.aws.amazon.com/iam/home#/policies"
  msg "========================================================================"
}

