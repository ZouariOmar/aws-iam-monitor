#!/usr/bin/env bash
# =========================================
# FILE
#   awsctl
#
# SYNOPSIS
#   AWS lifecycle orchestration CLI for aws-iam-monitor.
#
# DESCRIPTION
#   Unified command-line interface for provisioning, managing, monitoring,
#   testing, and tearing down the complete aws-iam-monitor security infrastructure.
#
#   Orchestrates dedicated management modules:
#     - iamctl          : IAM users, groups, roles, customer-managed policies
#     - cloud_trail_ctl : CloudTrail trail, S3 log bucket, encryption & selectors
#     - sns_ctl         : SNS alert topic, topic policy, email subscriptions
#     - lambda_ctl      : Monitoring Lambda, audit S3 storage & logs
#     - event_bridge_ctl: EventBridge rule, CloudTrail filtering & Lambda target
#
#   Supported lifecycle actions:
#     --up      Creates and configures infrastructure components.
#     --down    Tears down configured infrastructure components.
#     --status  Displays status and configuration of components.
#     --test    Runs component and end-to-end automated test suites.
#
#   Supported targets:
#     iam          Manage IAM policies, groups, users, and optional roles.
#     cloud-trail  Manage CloudTrail management event logging & S3 log bucket.
#     sns          Manage SNS alert topic and email subscriptions.
#     lambda       Manage monitoring Lambda function & audit S3 storage.
#     event-bridge Manage EventBridge rule, event filtering & Lambda target.
#     all          Manage complete end-to-end monitoring pipeline.
#
# USAGE
#   ./awsctl <--up|--down|--status|--test> [TARGET] [OPTIONS]
#
# OPTIONS
#   --up | --down | --status | --test   Lifecycle action.
#   TARGET                              Component to operate on:
#                                       iam, cloud-trail, sns, lambda, event-bridge, all.
#                                       Default: all
#   -r, --role                          Enable IAM role management in IAM target.
#   -v, --verbose                       Enable verbose execution logging.
#   -h, --help                          Show this help message.
#
# EXAMPLES
#   Create complete monitoring pipeline:
#     ./awsctl --up all
#
#   Create SNS alert environment:
#     ./awsctl --up sns
#
#   Check status of complete pipeline:
#     ./awsctl --status all
#
#   Run EventBridge tests:
#     ./awsctl --test event-bridge
#
#   Tear down complete infrastructure:
#     ./awsctl --down all
#
# DEPENDENCIES
#   AWS CLI v2, jq, sed, zip, openssl
#
# REQUIRED AWS PERMISSIONS
#   Requires administrative access to IAM, CloudTrail, SNS, EventBridge, Lambda,
#   S3, and CloudWatch Logs in the target AWS account.
#
# EXIT CODES
#   0   Success
#   1   Error
#
# NOTES
#   Project     : aws-iam-monitor
#   Version     : 2.0
#   Author      : @ZouariOmar (zouariomar20@gmail.com)
#   Created     : 14/07/2026
#   Updated     : 03/08/2026
#
# shellcheck disable=SC1090,SC1091
# =========================================
set -Eeuo pipefail

#####################
### CONFIGURATION ###
#####################

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${LIB_DIR:-${SCRIPT_DIR}/lib}"

# Sub-script locations
IAM_CTL_SCRIPT="${SCRIPT_DIR}/iam/src/iamctl"
CLOUD_TRAIL_CTL_SCRIPT="${SCRIPT_DIR}/cloud-trail/src/cloud_trail_ctl"
SNS_CTL_SCRIPT="${SCRIPT_DIR}/sns/src/sns_ctl"
LAMBDA_CTL_SCRIPT="${SCRIPT_DIR}/lambda/src/lambda_ctl"
EVENT_BRIDGE_CTL_SCRIPT="${SCRIPT_DIR}/event-bridge/src/event_bridge_ctl"

# Global state
AWS_ACCOUNT_ID="${AWS_ACCOUNT_ID:-}"
AWS_REGION="${AWS_REGION:-}"
ACTION="--up"
TARGET="all"
ENABLE_ROLES=false
VERBOSE="${VERBOSE:-false}"

######################
### !CONFIGURATION ###
######################

usage() {
  local exit_code="${1:-1}"
  cat <<EOF
$(msg "USAGE:")

  $(basename "$0") <ACTION> [TARGET] [OPTIONS]


$(msg "ACTIONS:")

  --up
      Create and configure infrastructure components.

  --down
      Tear down configured infrastructure components.

  --status
      Display status and health of components.

  --test
      Run automated test suites.


$(msg "TARGETS:")

  iam           Manage IAM policies, groups, users, and roles.
  cloud-trail   Manage CloudTrail trail and log S3 bucket.
  sns           Manage SNS alert topic and subscriptions.
  lambda        Manage monitoring Lambda function & S3 audit storage.
  event-bridge  Manage EventBridge rule, CloudTrail filtering & Lambda target.
  all           Manage complete monitoring infrastructure (default).


$(msg "OPTIONS:")

  -r, --role      Enable IAM role management.
  -v, --verbose   Enable verbose execution logging.
  -h, --help      Show this help message.


$(msg "EXAMPLES:")

  Create complete infrastructure:
    $(basename "$0") --up all

  Check CloudTrail status:
    $(basename "$0") --status cloud-trail

  Test Lambda component:
    $(basename "$0") --test lambda

  Deploy IAM with roles in verbose mode:
    $(basename "$0") --up iam --role --verbose

  Tear down complete infrastructure:
    $(basename "$0") --down all
EOF
  exit "$exit_code"
}

# ---------------------------------------------------------------------------
# check_aws_auth
# ---------------------------------------------------------------------------
check_aws_auth() {
  msg INFO "Validating AWS credentials..."

  local identity
  if ! identity=$(aws sts get-caller-identity --output json 2>&1); then
    msg ERROR "AWS authentication failed. Credentials are not configured or invalid."
    msg INFO "Run: aws configure"
    [[ "${VERBOSE:-false}" == true ]] && msg DEBUG "$identity"
    exit 1
  fi

  AWS_ACCOUNT_ID=$(jq -r '.Account' <<<"$identity")
  local user_arn
  user_arn=$(jq -r '.Arn' <<<"$identity")

  msg SUCCESS "AWS authentication validated (Account: ${AWS_ACCOUNT_ID})"
  if [[ "${VERBOSE:-false}" == true ]]; then
    msg DEBUG "Caller Identity ARN: ${user_arn}"
  fi
}

# ---------------------------------------------------------------------------
# check_aws_region
# ---------------------------------------------------------------------------
check_aws_region() {
  msg INFO "Validating AWS region..."

  AWS_REGION="${AWS_REGION:-$(aws configure get region 2>/dev/null || echo '')}"

  if [[ -z "$AWS_REGION" ]]; then
    AWS_REGION="us-east-1"
    msg WARNING "AWS region not set in config; defaulting to 'us-east-1'"
  fi

  msg SUCCESS "AWS region: ${AWS_REGION}"
}

# ---------------------------------------------------------------------------
# execute_target TARGET ACTION ARGS...
# ---------------------------------------------------------------------------
execute_target() {
  local target="$1"
  local action="$2"
  shift 2

  local pass_args=("$action" --aws-account-id "$AWS_ACCOUNT_ID" --aws-region "$AWS_REGION" "$@")

  case "$target" in
  iam)
    run_script "$IAM_CTL_SCRIPT" "$action" --aws-account-id "$AWS_ACCOUNT_ID" "$@"
    ;;
  cloud-trail)
    run_script "$CLOUD_TRAIL_CTL_SCRIPT" "${pass_args[@]}"
    ;;
  sns)
    run_script "$SNS_CTL_SCRIPT" "${pass_args[@]}"
    ;;
  lambda)
    run_script "$LAMBDA_CTL_SCRIPT" "${pass_args[@]}"
    ;;
  event-bridge)
    run_script "$EVENT_BRIDGE_CTL_SCRIPT" "${pass_args[@]}"
    ;;
  *)
    msg ERROR "Unknown target: $target"
    usage
    ;;
  esac
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------
main() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --up | --down | --status | --test)
      ACTION="$1"
      if [[ $# -gt 1 && ! "$2" =~ ^- ]]; then
        TARGET="$2"
        shift 2
      else
        shift 1
      fi
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -r | --role)
      ENABLE_ROLES=true
      shift
      ;;
    -h | --help)
      usage 0
      ;;
    *)
      if [[ "$1" =~ ^(iam|cloud-trail|sns|lambda|event-bridge|all)$ ]]; then
        TARGET="$1"
        shift
      else
        msg ERROR "Unknown option: $1"
        usage
      fi
      ;;
    esac
  done

  # Validate requirements
  check_requirements aws jq sed zip openssl

  # Authenticate AWS
  check_aws_auth
  check_aws_region

  local common_flags=()
  [[ "${VERBOSE:-false}" == true ]] && common_flags+=(--verbose)
  [[ "${ENABLE_ROLES:-false}" == true ]] && common_flags+=(--role)

  msg INFO "Action : ${ACTION}"
  msg INFO "Target : ${TARGET}"
  msg INFO "Region : ${AWS_REGION}"
  msg INFO "Account: ${AWS_ACCOUNT_ID}"
  msg "========================================================================"

  if [[ "$TARGET" != "all" ]]; then
    execute_target "$TARGET" "$ACTION" "${common_flags[@]}"
  else
    case "$ACTION" in
    --up)
      # Deployment Order: IAM -> CloudTrail -> SNS -> Lambda -> EventBridge
      msg INFO "=== Stage 1/5: IAM Environment ==="
      execute_target iam "$ACTION" "${common_flags[@]}"

      msg INFO "=== Stage 2/5: CloudTrail Environment ==="
      execute_target cloud-trail "$ACTION" "${common_flags[@]}"

      msg INFO "=== Stage 3/5: SNS Alert Environment ==="
      execute_target sns "$ACTION" "${common_flags[@]}"

      msg INFO "=== Stage 4/5: Lambda Monitoring Environment ==="
      execute_target lambda "$ACTION" "${common_flags[@]}"

      msg INFO "=== Stage 5/5: EventBridge Rules & Target Wiring ==="
      execute_target event-bridge "$ACTION" "${common_flags[@]}"
      ;;
    --down)
      # Teardown Order: EventBridge -> Lambda -> SNS -> CloudTrail -> IAM
      msg INFO "=== Teardown Stage 1/5: EventBridge Rules ==="
      execute_target event-bridge "$ACTION" "${common_flags[@]}"

      msg INFO "=== Teardown Stage 2/5: Lambda Monitoring Environment ==="
      execute_target lambda "$ACTION" "${common_flags[@]}"

      msg INFO "=== Teardown Stage 3/5: SNS Alert Environment ==="
      execute_target sns "$ACTION" "${common_flags[@]}"

      msg INFO "=== Teardown Stage 4/5: CloudTrail Environment ==="
      execute_target cloud-trail "$ACTION" "${common_flags[@]}"

      msg INFO "=== Teardown Stage 5/5: IAM Environment ==="
      execute_target iam "$ACTION" "${common_flags[@]}"
      ;;
    --status | --test)
      execute_target iam "$ACTION" "${common_flags[@]}"
      execute_target cloud-trail "$ACTION" "${common_flags[@]}"
      execute_target sns "$ACTION" "${common_flags[@]}"
      execute_target lambda "$ACTION" "${common_flags[@]}"
      execute_target event-bridge "$ACTION" "${common_flags[@]}"
      ;;
    esac
  fi

  msg SUCCESS "awsctl execution complete for action '${ACTION}' on target '${TARGET}'"
}

# ---------------------------------------------------------------------------
# Bootstrap
# ---------------------------------------------------------------------------
if [[ -s "${LIB_DIR}/common" ]]; then
  # shellcheck disable=SC1091
  . "${LIB_DIR}/common"
else
  echo "[ERROR] Missing: ${LIB_DIR}/common" >&2
  exit 1
fi
load_script "${LIB_DIR}/logger"
load_script "${LIB_DIR}/requirements"

# Load optional .env configuration
load_env_if_exists "${SCRIPT_DIR}/.env"

