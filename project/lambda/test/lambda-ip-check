#!/usr/bin/env bash
# =========================================
# FILE
#   lambda/test/lambda-ip-check
#
# SYNOPSIS
#   Test script to verify IP whitelist enforcement in the Lambda function.
#
# DESCRIPTION
#   Invokes the deployed Lambda function with a CloudTrail-style event
#   that carries a source IP outside the configured ALLOWED_IPS whitelist.
#
#   Verifies:
#     1. The Lambda response status is "denied" with reason "unauthorized_ip".
#     2. The UnauthorizedIPAccess CloudWatch metric was emitted within the
#        last 5 minutes in the AWSIAMMonitor namespace.
#
# USAGE
#   ./lambda-ip-check
#
# EXIT CODES
#   0   All assertions passed
#   1   Assertion failed or invocation error
#
# DEPENDENCIES
#   AWS CLI v2, jq
# =========================================
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${LIB_DIR:-${SCRIPT_DIR}/../../lib}"

LAMBDA_FUNCTION_NAME="${LAMBDA_FUNCTION_NAME:-aws-iam-monitor-lambda}"
AWS_REGION="${AWS_REGION:-$(aws configure get region 2>/dev/null || echo 'us-east-1')}"
TEST_RESPONSE_FILE="/tmp/lambda-ip-check-response.json"
WAIT_SECONDS="${WAIT_SECONDS:-120}"

# An IP that is guaranteed NOT to be in ALLOWED_IPS under normal configuration.
BLOCKED_TEST_IP="10.255.255.1"

# A minimal CloudTrail-style event with a blocked source IP.
TEST_PAYLOAD=$(jq -n \
  --arg ip "$BLOCKED_TEST_IP" \
  '{
    "detail": {
      "eventName":         "CreateUser",
      "eventSource":       "iam.amazonaws.com",
      "sourceIPAddress":   $ip,
      "awsRegion":         "us-east-1",
      "recipientAccountId": "000000000000",
      "eventTime":         "2026-08-11T10:00:00Z",
      "userIdentity": {
        "type": "IAMUser",
        "userName": "ip-check-test-actor"
      },
      "requestParameters": {
        "userName": "ip-check-test-target"
      }
    }
  }')

# ---------------------------------------------------------------------------
# Bootstrap
# ---------------------------------------------------------------------------
if [[ -s "${LIB_DIR}/common" ]]; then
  # shellcheck disable=SC1091
  . "${LIB_DIR}/common"
else
  echo "[ERROR] Missing: ${LIB_DIR}/common" >&2
  exit 1
fi
load_script "${LIB_DIR}/logger"

# Load optional .env configuration
load_env_if_exists "${SCRIPT_DIR}/../../.env"

# ---------------------------------------------------------------------------
# 1. Invoke Lambda with the blocked-IP payload
# ---------------------------------------------------------------------------
msg INFO "=== Lambda IP Whitelist Check Test ==="
msg INFO "Function.....${LAMBDA_FUNCTION_NAME}"
msg INFO "Region.......${AWS_REGION}"
msg INFO "Blocked IP...${BLOCKED_TEST_IP}"
msg INFO "Invoking Lambda with blocked source IP..."

if ! aws lambda invoke \
  --function-name "$LAMBDA_FUNCTION_NAME" \
  --payload "$TEST_PAYLOAD" \
  --cli-binary-format raw-in-base64-out \
  --region "$AWS_REGION" \
  "$TEST_RESPONSE_FILE" >/dev/null; then
  msg ERROR "Lambda invocation failed"
  exit 1
fi

msg SUCCESS "Lambda invocation completed"
msg INFO "Response payload:"
cat "$TEST_RESPONSE_FILE"
echo ""

# ---------------------------------------------------------------------------
# 2. Assert status == "denied" and reason == "unauthorized_ip"
# ---------------------------------------------------------------------------
STATUS=$(jq -r '.status // empty' "$TEST_RESPONSE_FILE")
REASON=$(jq -r '.reason // empty' "$TEST_RESPONSE_FILE")

if [[ "$STATUS" != "denied" ]]; then
  msg ERROR "ASSERTION FAILED: expected status='denied', got status='${STATUS}'"
  msg INFO "Hint: check that ALLOWED_IPS is set in the Lambda environment and does NOT include ${BLOCKED_TEST_IP}"
  rm -f "$TEST_RESPONSE_FILE"
  exit 1
fi

if [[ "$REASON" != "unauthorized_ip" ]]; then
  msg ERROR "ASSERTION FAILED: expected reason='unauthorized_ip', got reason='${REASON}'"
  rm -f "$TEST_RESPONSE_FILE"
  exit 1
fi

msg SUCCESS "ASSERTION PASSED: Lambda correctly denied the blocked IP (status=denied, reason=unauthorized_ip)"
rm -f "$TEST_RESPONSE_FILE"

# ---------------------------------------------------------------------------
# 3. Verify UnauthorizedIPAccess metric was emitted (last 5 minutes)
# ---------------------------------------------------------------------------
for ((seconds_left = WAIT_SECONDS; seconds_left > 0; seconds_left--)); do
  printf "\r%b[INFO]%b Waiting %2ds for CloudWatch/Lambda propagation..." "$_LOG_BLUE" "$_LOG_RESET" "$seconds_left"
  sleep 1
done
printf "\n"

msg INFO "Checking CloudWatch for UnauthorizedIPAccess metric (last 5 min)..."

START_TIME=$(date -u -d '5 minutes ago' +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null ||
  date -u -v-5M +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null ||
  true)
END_TIME=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

METRIC_OUTPUT=$(aws cloudwatch get-metric-statistics \
  --namespace "AWSIAMMonitor" \
  --metric-name "UnauthorizedIPAccess" \
  --dimensions "Name=SourceIP,Value=${BLOCKED_TEST_IP}" \
  --start-time "${START_TIME}" \
  --end-time "${END_TIME}" \
  --period 300 \
  --statistics Sum \
  --region "$AWS_REGION" \
  --output json 2>/dev/null || echo '{"Datapoints":[]}')

DATAPOINT_COUNT=$(jq '.Datapoints | length' <<<"$METRIC_OUTPUT")

if [[ "$DATAPOINT_COUNT" -gt 0 ]]; then
  METRIC_SUM=$(jq '[.Datapoints[].Sum] | add' <<<"$METRIC_OUTPUT")
  msg SUCCESS "ASSERTION PASSED: UnauthorizedIPAccess metric found (Sum=${METRIC_SUM} in the last 5 min)"
else
  msg WARNING "UnauthorizedIPAccess metric not yet visible in CloudWatch (may need 1-2 min for propagation)"
  msg INFO "Re-check manually:"
  msg "  aws cloudwatch get-metric-statistics \\"
  msg "    --namespace AWSIAMMonitor \\"
  msg "    --metric-name UnauthorizedIPAccess \\"
  msg "    --dimensions Name=SourceIP,Value=${BLOCKED_TEST_IP} \\"
  msg "    --start-time \$(date -u -d '10 minutes ago' +\"%Y-%m-%dT%H:%M:%SZ\") \\"
  msg "    --end-time \$(date -u +\"%Y-%m-%dT%H:%M:%SZ\") \\"
  msg "    --period 300 --statistics Sum --region ${AWS_REGION}"
fi

msg SUCCESS "Lambda IP whitelist check test complete"
