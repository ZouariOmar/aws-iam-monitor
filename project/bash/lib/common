#!/usr/bin/env bash
# =========================================
# FILE
#   lib/common
#
# SYNOPSIS
#   Common utility functions for aws-iam-monitor scripts.
#
# DESCRIPTION
#   Provides shared helper functions used across all
#   aws-iam-monitor lifecycle scripts.
#
#   Functions:
#     load_script       Source a Bash library file.
#     check_script      Assert a script exists and is executable.
#     run_script        Execute a script with error propagation.
#     require_variable  Assert a named variable is non-empty.
#     build_arn         Construct an AWS ARN string.
#     wait_lambda_active
#                       Poll until a Lambda function reaches Active state.
#     load_env_if_exists
#                       Optionally load environment variables from a .env file.
#
# USAGE
#   # Bootstrap pattern used by all scripts:
#   if [[ -s "${LIB_DIR}/common" ]]; then
#     # shellcheck disable=SC1091
#     . "${LIB_DIR}/common"
#   else
#     echo "[ERROR] Missing: ${LIB_DIR}/common" >&2
#     exit 1
#   fi
#   load_script "${LIB_DIR}/logger"
#
# NOTES
#   Project     : aws-iam-monitor
#   Version     : 2.0
#   Author      : @ZouariOmar (zouariomar20@gmail.com)
#   Created     : 14/07/2026
#   Updated     : 03/08/2026
#
# shellcheck disable=SC1090
# =========================================
set -Eeuo pipefail

#####################
### CONFIGURATION ###
#####################

# Global flag — overridden by --verbose on any script's CLI.
VERBOSE="${VERBOSE:-false}"

######################
### FUNCTIONS      ###
######################

# ---------------------------------------------------------------------------
# load_script PATH
#
# Source a Bash library. Exits with error if the file is missing or empty.
# Prints a SUCCESS log when VERBOSE=true.
# ---------------------------------------------------------------------------
load_script() {
  local script="$1"

  if [[ ! -s "$script" ]]; then
    if declare -f msg &>/dev/null; then
      msg ERROR "Missing script: '$script'"
    else
      echo "[ERROR] Missing script: '$script'" >&2
    fi
    exit 1
  fi

  # shellcheck disable=SC1090
  . "$script"

  if [[ "${VERBOSE:-false}" == true ]] && declare -f msg &>/dev/null; then
    msg SUCCESS "Loaded: '$script'"
  fi
}

# ---------------------------------------------------------------------------
# check_script PATH
#
# Validate that PATH exists and is executable. Exits with a descriptive
# error otherwise.
# ---------------------------------------------------------------------------
check_script() {
  local script="$1"

  if [[ -z "$script" ]]; then
    msg ERROR "check_script: path argument is empty"
    exit 1
  fi

  if [[ ! -f "$script" ]]; then
    msg ERROR "Script not found: '$script'"
    exit 1
  fi

  if [[ ! -x "$script" ]]; then
    msg ERROR "Script is not executable: '$script'"
    msg INFO "Run: chmod +x '$script'"
    exit 1
  fi
}

# ---------------------------------------------------------------------------
# run_script PATH [ARGS...]
#
# Validate and execute a script, propagating its exit code.
# Prints INFO log before execution when VERBOSE=true.
# ---------------------------------------------------------------------------
run_script() {
  local script="$1"
  shift

  check_script "$script"

  if [[ "${VERBOSE:-false}" == true ]]; then
    msg INFO "Running: $script $*"
  fi

  "$script" "$@"

  local status=$?
  if [[ $status -ne 0 ]]; then
    msg ERROR "Script failed: '$script' (exit code: $status)"
    exit "$status"
  fi
}

# ---------------------------------------------------------------------------
# require_variable NAME
#
# Assert that the variable named NAME is set and non-empty.
# Exits with an error if the variable is unset or empty.
# ---------------------------------------------------------------------------
require_variable() {
  local name="$1"
  local value="${!name:-}"

  if [[ -z "$value" ]]; then
    msg ERROR "Required variable '\$${name}' is not set or empty"
    exit 1
  fi
}

# ---------------------------------------------------------------------------
# build_arn SERVICE REGION ACCOUNT RESOURCE
#
# Construct a well-formed AWS ARN.
#
# Arguments:
#   SERVICE   AWS service name (e.g. iam, lambda, events, s3, sns)
#   REGION    AWS region (empty string "" for global services like IAM)
#   ACCOUNT   12-digit AWS account ID
#   RESOURCE  Resource path (e.g. policy/MyPolicy, function/my-fn, topic-name)
#
# Output:
#   arn:aws:<service>:<region>:<account>:<resource>
# ---------------------------------------------------------------------------
build_arn() {
  local service="$1"
  local region="${2:-}"
  local account="${3:-}"
  local resource="$4"

  printf 'arn:aws:%s:%s:%s:%s\n' "$service" "$region" "$account" "$resource"
}

# ---------------------------------------------------------------------------
# wait_lambda_active FUNCTION_NAME [MAX_ATTEMPTS] [SLEEP_SECONDS]
#
# Poll the Lambda function state until it reaches "Active".
# Returns 0 on success, 1 on timeout.
# ---------------------------------------------------------------------------
wait_lambda_active() {
  local fn_name="$1"
  local max_attempts="${2:-30}"
  local sleep_sec="${3:-2}"
  local attempt=0

  msg INFO "Waiting for Lambda function '$fn_name' to become Active..."

  while [[ $attempt -lt $max_attempts ]]; do
    local state
    state=$(aws lambda get-function-configuration \
      --function-name "$fn_name" \
      --query 'State' \
      --output text 2>/dev/null || echo "Unknown")

    if [[ "$state" == "Active" ]]; then
      msg SUCCESS "Lambda function is Active"
      return 0
    fi

    attempt=$((attempt + 1))
    sleep "$sleep_sec"
  done

  msg ERROR "Lambda function '$fn_name' did not become Active (waited $((max_attempts * sleep_sec))s)"
  return 1
}

# ---------------------------------------------------------------------------
# load_env_if_exists [FILE_PATH]
#
# Optionally load environment variables from a .env file if present.
# Does not error if the file is missing.
# ---------------------------------------------------------------------------
load_env_if_exists() {
  local env_file="${1:-}"

  if [[ -z "$env_file" ]]; then
    # Look for .env in current working dir or project root
    if [[ -f ".env" ]]; then
      env_file=".env"
    elif [[ -f "${SCRIPT_DIR}/.env" ]]; then
      env_file="${SCRIPT_DIR}/.env"
    elif [[ -f "${SCRIPT_DIR}/../.env" ]]; then
      env_file="${SCRIPT_DIR}/../.env"
    elif [[ -f "${SCRIPT_DIR}/../../.env" ]]; then
      env_file="${SCRIPT_DIR}/../../.env"
    fi
  fi

  if [[ -n "$env_file" && -f "$env_file" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$env_file"
    set +a
    if [[ "${VERBOSE:-false}" == true ]] && declare -f msg &>/dev/null; then
      msg INFO "Loaded configuration from: $env_file"
    fi
  fi
}
