#!/usr/bin/env bash
# =========================================
# FILE
#   sns/test/topic_exists
#
# SYNOPSIS
#   Test script to verify SNS topic existence.
# =========================================
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${LIB_DIR:-${SCRIPT_DIR}/../../lib}"

TOPIC_NAME="${SNS_TOPIC_NAME:-iam-alerts}"
AWS_REGION="${AWS_REGION:-$(aws configure get region 2>/dev/null || echo 'us-east-1')}"

if [[ -s "${LIB_DIR}/common" ]]; then
  # shellcheck disable=SC1091
  . "${LIB_DIR}/common"
else
  echo "[ERROR] Missing: ${LIB_DIR}/common" >&2
  exit 1
fi
load_script "${LIB_DIR}/logger"

topic_arn=$(aws sns list-topics \
  --region "$AWS_REGION" \
  --query "Topics[?contains(TopicArn, ':${TOPIC_NAME}')].TopicArn" \
  --output text 2>/dev/null | head -n1 || echo "")

if [[ -n "$topic_arn" ]]; then
  msg SUCCESS "SNS topic exists: ${topic_arn}"
  exit 0
fi

msg ERROR "SNS topic does not exist: ${TOPIC_NAME}"
exit 1
