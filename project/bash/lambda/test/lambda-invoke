#!/usr/bin/env bash
# =========================================
# FILE
#   lambda/test/lambda-invoke
#
# SYNOPSIS
#   Test script to invoke Lambda function with a test payload.
# =========================================
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${LIB_DIR:-${SCRIPT_DIR}/../../lib}"

LAMBDA_FUNCTION_NAME="${LAMBDA_FUNCTION_NAME:-aws-iam-monitor-lambda}"
AWS_REGION="${AWS_REGION:-$(aws configure get region 2>/dev/null || echo 'us-east-1')}"
TEST_RESPONSE_FILE="/tmp/lambda-test-response.json"

TEST_PAYLOAD='{
  "eventName": "CreateUser",
  "eventSource": "iam.amazonaws.com",
  "test": true
}'

if [[ -s "${LIB_DIR}/common" ]]; then
  # shellcheck disable=SC1091
  . "${LIB_DIR}/common"
else
  echo "[ERROR] Missing: ${LIB_DIR}/common" >&2
  exit 1
fi
load_script "${LIB_DIR}/logger"

msg INFO "Invoking Lambda function '${LAMBDA_FUNCTION_NAME}' with test payload..."

if aws lambda invoke \
  --function-name "$LAMBDA_FUNCTION_NAME" \
  --payload "$TEST_PAYLOAD" \
  --cli-binary-format raw-in-base64-out \
  --region "$AWS_REGION" \
  "$TEST_RESPONSE_FILE" >/dev/null; then

  msg SUCCESS "Lambda invocation successful"
  if [[ -f "$TEST_RESPONSE_FILE" ]]; then
    msg INFO "Response payload:"
    cat "$TEST_RESPONSE_FILE"
    echo ""
    rm -f "$TEST_RESPONSE_FILE"
  fi
  exit 0
fi

msg ERROR "Lambda invocation failed"
exit 1
