#!/usr/bin/env bash
# =========================================
# FILE
#   lambda/test/lambda-exists
#
# SYNOPSIS
#   Test script to verify Lambda function existence.
# =========================================
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${LIB_DIR:-${SCRIPT_DIR}/../../lib}"

LAMBDA_FUNCTION_NAME="${LAMBDA_FUNCTION_NAME:-aws-iam-monitor-lambda}"
AWS_REGION="${AWS_REGION:-$(aws configure get region 2>/dev/null || echo 'us-east-1')}"

if [[ -s "${LIB_DIR}/common" ]]; then
  # shellcheck disable=SC1091
  . "${LIB_DIR}/common"
else
  echo "[ERROR] Missing: ${LIB_DIR}/common" >&2
  exit 1
fi
load_script "${LIB_DIR}/logger"

if aws lambda get-function --function-name "$LAMBDA_FUNCTION_NAME" --region "$AWS_REGION" &>/dev/null; then
  msg SUCCESS "Lambda function exists: ${LAMBDA_FUNCTION_NAME}"
  exit 0
fi

msg ERROR "Lambda function does not exist: ${LAMBDA_FUNCTION_NAME}"
exit 1
