#!/usr/bin/env bash
# =========================================
# FILE
#   lambda/test/lambda-config
#
# SYNOPSIS
#   Test script to verify Lambda function configuration state.
# =========================================
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${LIB_DIR:-${SCRIPT_DIR}/../../lib}"

LAMBDA_FUNCTION_NAME="${LAMBDA_FUNCTION_NAME:-aws-iam-monitor-lambda}"
AWS_REGION="${AWS_REGION:-$(aws configure get region 2>/dev/null || echo 'us-east-1')}"

if [[ -s "${LIB_DIR}/common" ]]; then
  # shellcheck disable=SC1091
  . "${LIB_DIR}/common"
else
  echo "[ERROR] Missing: ${LIB_DIR}/common" >&2
  exit 1
fi
load_script "${LIB_DIR}/logger"

STATE=$(aws lambda get-function-configuration \
  --function-name "$LAMBDA_FUNCTION_NAME" \
  --region "$AWS_REGION" \
  --query 'State' \
  --output text 2>/dev/null || echo "Unknown")

if [[ "$STATE" == "Active" ]]; then
  msg SUCCESS "Lambda state is Active"
  exit 0
fi

msg ERROR "Lambda state invalid: ${STATE}"
exit 1
