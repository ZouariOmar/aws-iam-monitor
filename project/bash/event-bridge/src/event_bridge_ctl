#!/usr/bin/env bash
# =========================================
# FILE
#   event-bridge/src/event_bridge_ctl
#
# SYNOPSIS
#   Amazon EventBridge rule lifecycle management for IAM monitoring.
#
# DESCRIPTION
#   Creates, configures, monitors, tests, and removes an Amazon EventBridge
#   rule that filters AWS CloudTrail IAM events and targets the monitoring
#   AWS Lambda function.
#
#   Lifecycle operations:
#     --up      Create or update the EventBridge rule (idempotent; compares
#               SHA-256 pattern hash), register the Lambda target, and
#               grant invocation permission to EventBridge.
#     --down    Remove targets from the rule, revoke Lambda invocation
#               permission, then delete the rule.
#     --status  Report rule existence, pattern configuration, state,
#               targets, and CloudWatch event-matching metrics.
#     --test    Execute all automated test scripts in test/.
#
# USAGE
#   ./event_bridge_ctl --up   --aws-account-id <id> --aws-region <region> [OPTIONS]
#   ./event_bridge_ctl --down --aws-region <region> [OPTIONS]
#   ./event_bridge_ctl --status --aws-region <region> [OPTIONS]
#   ./event_bridge_ctl --test [OPTIONS]
#
# OPTIONS
#   --up | --down | --status | --test   Lifecycle action (required).
#   --aws-account-id <id>               AWS account ID.
#   --aws-region   <region>             AWS region (required).
#   --rule-name    <name>               EventBridge rule name.
#                                       Default: aws-iam-monitor-rule
#   --event-pattern-file <path>         Path to JSON event pattern.
#                                       Default: <script>/../policies/iam-event-pattern.json
#   --lambda-arn   <arn>                Target Lambda function ARN.
#                                       Default: derived from account & region.
#   -v, --verbose                       Enable verbose execution output.
#   -h, --help                          Show this help.
#
# EXAMPLES
#   Create EventBridge rule with Lambda target:
#     ./event_bridge_ctl --up \
#       --aws-account-id 123456789012 \
#       --aws-region us-east-1
#
#   Check rule status:
#     ./event_bridge_ctl --status --aws-region us-east-1
#
#   Run tests:
#     ./event_bridge_ctl --test
#
#   Delete EventBridge rule:
#     ./event_bridge_ctl --down --aws-region us-east-1
#
# DEPENDENCIES
#   AWS CLI v2, jq, sha256sum
#
# REQUIRED IAM PERMISSIONS
#   events:PutRule          events:DeleteRule       events:DescribeRule
#   events:EnableRule       events:DisableRule      events:ListTargetsByRule
#   events:PutTargets       events:RemoveTargets
#   lambda:AddPermission    lambda:RemovePermission
#   cloudwatch:GetMetricStatistics
#
# EXIT CODES
#   0   Success
#   1   Error
#
# NOTES
#   Project     : aws-iam-monitor
#   Version     : 2.0
#   Author      : @ZouariOmar (zouariomar20@gmail.com)
#   Created     : 20/07/2026
#   Updated     : 03/08/2026
#
# shellcheck disable=SC1090,SC1091
# =========================================
set -Eeuo pipefail

