### CONFIGURATION ###
#####################

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${LIB_DIR:-${SCRIPT_DIR}/../../lib}"

EVENT_BRIDGE_POLICIES_DIR="${SCRIPT_DIR}/../policies"
EVENT_BRIDGE_TEST_DIR="${SCRIPT_DIR}/../test"

# Defaults.
AWS_ACCOUNT_ID=""
AWS_REGION=""
RULE_NAME="aws-iam-monitor-rule"
EVENT_PATTERN_FILE="${EVENT_BRIDGE_POLICIES_DIR}/iam-event-pattern.json"
LAMBDA_FUNCTION_NAME="aws-iam-monitor-lambda"
LAMBDA_ARN=""
ACTION=""
VERBOSE="${VERBOSE:-false}"

######################
### !CONFIGURATION ###
######################

usage() {
  cat <<EOF
$(msg "USAGE:")

  $(basename "$0") <--up|--down|--status|--test> --aws-region <region> [OPTIONS]


$(msg "ACTIONS:")

  --up
      Create or update the EventBridge rule, attach the Lambda target,
      and grant invocation permission to EventBridge.

  --down
      Remove targets, revoke Lambda permission, and delete the rule.

  --status
      Display rule state, pattern, targets, and metrics.

  --test
      Execute all tests in event-bridge/test/.


$(msg "OPTIONS:")

  --aws-account-id <id>        AWS account ID.
  --aws-region   <region>      AWS region.
  --rule-name    <name>        Rule name (default: aws-iam-monitor-rule).
  --event-pattern-file <path>  Path to pattern JSON file.
  --lambda-arn   <arn>         Target Lambda function ARN.
  -v, --verbose                Enable verbose execution output.
  -h, --help                   Show this help message.


$(msg "EXAMPLES:")

  Create rule:
    $(basename "$0") --up --aws-account-id 123456789012 --aws-region us-east-1

  Check status:
    $(basename "$0") --status --aws-region us-east-1

  Run tests:
    $(basename "$0") --test

  Delete rule:
    $(basename "$0") --down --aws-region us-east-1
EOF
  exit 1
}

# ---------------------------------------------------------------------------
# create_rule
# ---------------------------------------------------------------------------
create_rule() {
  msg INFO "Creating/updating EventBridge rule: $RULE_NAME"

  if [[ ! -f "$EVENT_PATTERN_FILE" ]]; then
    msg ERROR "Event pattern file missing: $EVENT_PATTERN_FILE"
    exit 1
  fi

  # 1. Create or update rule pattern.
  local exists=false
  if aws events describe-rule --name "$RULE_NAME" --region "$AWS_REGION" &>/dev/null; then
    exists=true

    local current_hash new_hash
    current_hash=$(aws events describe-rule \
      --name "$RULE_NAME" \
      --region "$AWS_REGION" \
      --query 'EventPattern' \
      --output text |
      jq -S . |
      sha256sum |
      cut -d' ' -f1)

    new_hash=$(jq -S . "$EVENT_PATTERN_FILE" | sha256sum | cut -d' ' -f1)

    if [[ "$current_hash" == "$new_hash" ]]; then
      msg INFO "Rule pattern for '$RULE_NAME' is already up to date"
    else
      msg INFO "Updating EventBridge rule pattern..."
      aws events put-rule \
        --name "$RULE_NAME" \
        --event-pattern "file://${EVENT_PATTERN_FILE}" \
        --state ENABLED \
        --region "$AWS_REGION" >/dev/null
      msg SUCCESS "Rule pattern updated"
    fi
  else
    msg INFO "Rule does not exist. Creating..."
    local err
    if ! err=$(aws events put-rule \
      --name "$RULE_NAME" \
      --event-pattern "file://${EVENT_PATTERN_FILE}" \
      --state ENABLED \
      --region "$AWS_REGION" \
      --output json 2>&1); then
      msg ERROR "Failed to create EventBridge rule '$RULE_NAME'"
      [[ "${VERBOSE:-false}" == true ]] && msg DEBUG "$err"
      exit 1
    fi
    msg SUCCESS "EventBridge rule created: $RULE_NAME"
  fi

  # 2. Grant EventBridge permission to invoke the Lambda function.
  if [[ -n "$LAMBDA_ARN" ]]; then
    msg INFO "Granting EventBridge permission to invoke Lambda..."

    local rule_arn
    rule_arn=$(build_arn events "$AWS_REGION" "$AWS_ACCOUNT_ID" "rule/${RULE_NAME}")

    # Statement ID must be unique per rule association.
    local statement_id="eventbridge-invoke-${RULE_NAME}"

    aws lambda add-permission \
      --function-name "$LAMBDA_FUNCTION_NAME" \
      --statement-id "$statement_id" \
      --action "lambda:InvokeFunction" \
      --principal "events.amazonaws.com" \
      --source-arn "$rule_arn" \
      --region "$AWS_REGION" >/dev/null 2>&1 || {
      [[ "${VERBOSE:-false}" == true ]] && msg DEBUG "Lambda permission statement '$statement_id' already exists"
    }

    msg SUCCESS "Lambda permission granted"

    # 3. Add Lambda as target for the rule.
    msg INFO "Registering Lambda target with EventBridge rule..."

    local target_json
    target_json=$(jq -n \
      --arg id "Target1" \
      --arg arn "$LAMBDA_ARN" \
      '[{Id: $id, Arn: $arn}]')

    aws events put-targets \
      --rule "$RULE_NAME" \
      --targets "$target_json" \
      --region "$AWS_REGION" >/dev/null

    msg SUCCESS "Lambda target registered: $LAMBDA_ARN"
  else
    msg WARNING "No Lambda ARN provided — skipping target registration"
  fi
}

# ---------------------------------------------------------------------------
# delete_rule
# ---------------------------------------------------------------------------
delete_rule() {
  msg INFO "Deleting EventBridge rule: $RULE_NAME"

  if ! aws events describe-rule --name "$RULE_NAME" --region "$AWS_REGION" &>/dev/null; then
    msg INFO "Rule '$RULE_NAME' does not exist — nothing to delete"
    return 0
  fi

  # 1. Remove targets from rule first (AWS requirement).
  msg INFO "Removing targets from rule..."
  local target_ids
  target_ids=$(aws events list-targets-by-rule \
    --rule "$RULE_NAME" \
    --region "$AWS_REGION" \
    --query 'Targets[].Id' \
    --output text 2>/dev/null |
    tr '\t' ' ')

  if [[ -n "$target_ids" ]]; then
    # Convert space-separated IDs to array for CLI.
    # shellcheck disable=SC2086
    aws events remove-targets \
      --rule "$RULE_NAME" \
      --ids $target_ids \
      --region "$AWS_REGION" >/dev/null
    msg SUCCESS "Targets removed"
  fi

  # 2. Revoke Lambda permission if Lambda exists.
  if aws lambda get-function --function-name "$LAMBDA_FUNCTION_NAME" --region "$AWS_REGION" &>/dev/null; then
    local statement_id="eventbridge-invoke-${RULE_NAME}"
    aws lambda remove-permission \
      --function-name "$LAMBDA_FUNCTION_NAME" \
      --statement-id "$statement_id" \
      --region "$AWS_REGION" >/dev/null 2>&1 || true
    [[ "${VERBOSE:-false}" == true ]] && msg DEBUG "Revoked Lambda permission statement"
  fi

  # 3. Delete rule.
  aws events delete-rule --name "$RULE_NAME" --region "$AWS_REGION"

  msg SUCCESS "EventBridge rule deleted: $RULE_NAME"
}

# ---------------------------------------------------------------------------
# rule_status
# ---------------------------------------------------------------------------
rule_status() {
  msg INFO "Checking EventBridge rule status: $RULE_NAME"

  if ! aws events describe-rule --name "$RULE_NAME" --region "$AWS_REGION" &>/dev/null; then
    msg WARNING "EventBridge rule '$RULE_NAME' does not exist"
    return 0
  fi

  msg SUCCESS "EventBridge rule exists: $RULE_NAME"

  msg INFO "Rule Description:"
  aws events describe-rule \
    --name "$RULE_NAME" \
    --region "$AWS_REGION" \
    --output json

  msg INFO "Rule Target(s):"
  aws events list-targets-by-rule \
    --rule "$RULE_NAME" \
    --region "$AWS_REGION" \
    --output json
}

# ---------------------------------------------------------------------------
# test_rule
# ---------------------------------------------------------------------------
test_rule() {
  msg INFO "Running EventBridge test suite..."

  if [[ ! -d "$EVENT_BRIDGE_TEST_DIR" ]]; then
    msg ERROR "Test directory not found: $EVENT_BRIDGE_TEST_DIR"
    return 1
  fi

  local test_files
  test_files=$(find "$EVENT_BRIDGE_TEST_DIR" -maxdepth 1 -type f | sort)

  if [[ -z "$test_files" ]]; then
    msg WARNING "No tests found in $EVENT_BRIDGE_TEST_DIR"
    return 0
  fi

  local failed=0
  local test_file

  while IFS= read -r test_file; do
    [[ -z "$test_file" ]] && continue

    if [[ ! -x "$test_file" ]]; then
      msg WARNING "Skipping non-executable test: $test_file"
      continue
    fi

    msg INFO "Running test: $(basename "$test_file")"

    if "$test_file"; then
      msg SUCCESS "Passed: $(basename "$test_file")"
    else
      msg ERROR "Failed: $(basename "$test_file")"
      failed=$((failed + 1))
    fi

  done <<<"$test_files"

  if [[ "$failed" -gt 0 ]]; then
    msg ERROR "$failed EventBridge test(s) failed"
    return 1
  fi

  msg SUCCESS "All EventBridge tests passed"
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------
main() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --up | --down | --status | --test)
      ACTION="$1"
      shift
      ;;
    --aws-account-id)
      AWS_ACCOUNT_ID="$2"
      shift 2
      ;;
    --aws-region)
      AWS_REGION="$2"
      shift 2
      ;;
    --rule-name)
      RULE_NAME="$2"
      shift 2
      ;;
    --event-pattern-file)
      EVENT_PATTERN_FILE="$2"
      shift 2
      ;;
    --lambda-arn)
      LAMBDA_ARN="$2"
      shift 2
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      ;;
    *)
      msg ERROR "Unknown option: $1"
      usage
      ;;
    esac
  done

  require_variable AWS_REGION

  if [[ -z "$LAMBDA_ARN" && -n "$AWS_ACCOUNT_ID" ]]; then
    LAMBDA_ARN=$(build_arn lambda "$AWS_REGION" "$AWS_ACCOUNT_ID" "function:${LAMBDA_FUNCTION_NAME}")
  fi

  case "${ACTION:-}" in
  --up) create_rule ;;
  --down) delete_rule ;;
  --status) rule_status ;;
  --test) test_rule ;;
  *)
    msg ERROR "Action required: --up, --down, --status, or --test"
    usage
    ;;
  esac

  local rule_arn
  rule_arn=$(build_arn events "$AWS_REGION" "${AWS_ACCOUNT_ID:-<account>}" "rule/${RULE_NAME}")

  msg "========================================================================================================="
  msg INFO "EventBridge Console...https://${AWS_REGION}.console.aws.amazon.com/events/home?region=${AWS_REGION}#/rules"
  msg INFO "Rule Name.............${RULE_NAME}"
  msg INFO "Rule ARN..............${rule_arn}"
  msg INFO "Event Pattern.........${EVENT_PATTERN_FILE}"
  msg INFO "Region................${AWS_REGION}"
  msg "========================================================================================================="
}

