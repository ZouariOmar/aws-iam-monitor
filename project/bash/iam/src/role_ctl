#!/usr/bin/env bash
# =========================================
# FILE
#   iam/src/role_ctl
#
# SYNOPSIS
#   AWS IAM role lifecycle management.
#
# DESCRIPTION
#   Creates and deletes AWS IAM roles with managed policy
#   attachments and trust policy configuration.
#
#   Lifecycle operations:
#     --up    Create the role (idempotent) and attach a managed
#             policy. Trust policy is read from a JSON file;
#             {{AWS_ACCOUNT_ID}} placeholders are substituted.
#     --down  Detach all managed policies, remove all inline
#             policies, remove instance profile associations,
#             then delete the role.
#
# USAGE
#   ./role_ctl --up   --role-name <name> --policy-name <name> \
#                     --trust-policy <file> --aws-account-id <id>
#   ./role_ctl --down --role-name <name> --aws-account-id <id>
#
# OPTIONS
#   --up | --down              Lifecycle action (required).
#   --role-name     <name>     IAM role name (required).
#   --policy-name   <name>     Managed policy name to attach (--up only).
#   --trust-policy  <path>     Absolute path to trust policy JSON.
#                              Supports {{AWS_ACCOUNT_ID}} placeholder.
#   --aws-account-id <id>      AWS account ID (required).
#   -v, --verbose              Enable verbose output.
#   -h, --help                 Show this help.
#
# EXAMPLES
#   Create a role:
#     ./role_ctl --up \
#       --role-name    EC2-AppRole \
#       --policy-name  DevPolicy \
#       --trust-policy /abs/path/to/iam-trust-policy.json \
#       --aws-account-id 123456789012
#
#   Delete a role:
#     ./role_ctl --down \
#       --role-name EC2-AppRole \
#       --aws-account-id 123456789012
#
# DEPENDENCIES
#   AWS CLI v2, sed
#
# REQUIRED IAM PERMISSIONS
#   iam:CreateRole                iam:GetRole
#   iam:DeleteRole                iam:AttachRolePolicy
#   iam:DetachRolePolicy          iam:ListAttachedRolePolicies
#   iam:DeleteRolePolicy          iam:ListRolePolicies
#   iam:ListInstanceProfilesForRole
#   iam:RemoveRoleFromInstanceProfile
#
# EXIT CODES
#   0   Success
#   1   Error
#
# NOTES
#   Project     : aws-iam-monitor
#   Version     : 2.0
#   Author      : @ZouariOmar (zouariomar20@gmail.com)
#   Created     : 20/07/2026
#   Updated     : 03/08/2026
#
# shellcheck disable=SC1090,SC1091
# =========================================
set -Eeuo pipefail

#####################
### CONFIGURATION ###
#####################

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${LIB_DIR:-${SCRIPT_DIR}/../../lib}"

ROLE_NAME=""
POLICY_NAME=""
TRUST_POLICY_FILE=""
AWS_ACCOUNT_ID=""
ACTION=""
VERBOSE="${VERBOSE:-false}"

######################
### !CONFIGURATION ###
######################

usage() {
  cat <<EOF
$(msg "USAGE:")

  $(basename "$0") --up   --role-name <name> --policy-name <name> \\
                          --trust-policy <file> --aws-account-id <id>

  $(basename "$0") --down --role-name <name> --aws-account-id <id>


$(msg "ACTIONS:")

  --up
      Create the IAM role and attach a managed policy.
      Idempotent: skips creation if the role already exists.

  --down
      Remove all role dependencies then delete the IAM role.


$(msg "OPTIONS:")

  --role-name    <name>   IAM role name.
  --policy-name  <name>   Managed policy name to attach (--up only).
  --trust-policy <path>   Path to trust policy JSON.
                          Supports {{AWS_ACCOUNT_ID}} placeholder.
  --aws-account-id <id>   AWS account ID.
  -v, --verbose           Enable verbose output.
  -h, --help              Show this help.


$(msg "EXAMPLES:")

  Create a role:
    $(basename "$0") --up \\
      --role-name    EC2-AppRole \\
      --policy-name  DevPolicy \\
      --trust-policy /path/to/iam-trust-policy.json \\
      --aws-account-id 123456789012

  Delete a role:
    $(basename "$0") --down \\
      --role-name EC2-AppRole \\
      --aws-account-id 123456789012
EOF
  exit 1
}

# ---------------------------------------------------------------------------
# create_role
# ---------------------------------------------------------------------------
create_role() {
  local policy_arn
  policy_arn=$(build_arn iam "" "$AWS_ACCOUNT_ID" "policy/${POLICY_NAME}")

  msg INFO "Creating role: $ROLE_NAME"

  if aws iam get-role --role-name "$ROLE_NAME" &>/dev/null; then
    msg INFO "Role already exists: $ROLE_NAME"
  else
    if [[ ! -f "$TRUST_POLICY_FILE" ]]; then
      msg ERROR "Trust policy file not found: $TRUST_POLICY_FILE"
      exit 1
    fi

    local trust_doc
    trust_doc=$(sed "s/{{AWS_ACCOUNT_ID}}/${AWS_ACCOUNT_ID}/g" "$TRUST_POLICY_FILE")

    local err
    if ! err=$(aws iam create-role \
      --role-name "$ROLE_NAME" \
      --assume-role-policy-document "$trust_doc" \
      --output json 2>&1); then
      msg ERROR "Failed to create role '$ROLE_NAME'"
      [[ "${VERBOSE:-false}" == true ]] && msg DEBUG "$err"
      exit 1
    fi

    msg SUCCESS "Role created: $ROLE_NAME"
  fi

  # Attach managed policy if not already attached.
  local attached
  attached=$(aws iam list-attached-role-policies \
    --role-name "$ROLE_NAME" \
    --query "AttachedPolicies[?PolicyArn=='${policy_arn}'].PolicyArn" \
    --output text 2>/dev/null)

  if [[ -z "$attached" ]]; then
    local err
    if ! err=$(aws iam attach-role-policy \
      --role-name "$ROLE_NAME" \
      --policy-arn "$policy_arn" 2>&1); then
      msg ERROR "Failed to attach policy '$POLICY_NAME' to role '$ROLE_NAME'"
      [[ "${VERBOSE:-false}" == true ]] && msg DEBUG "$err"
      exit 1
    fi
    msg SUCCESS "Attached policy '$POLICY_NAME' to role '$ROLE_NAME'"
  else
    msg INFO "Policy '$POLICY_NAME' already attached to role '$ROLE_NAME'"
  fi
}

# ---------------------------------------------------------------------------
# delete_role
# ---------------------------------------------------------------------------
delete_role() {
  msg INFO "Deleting role: $ROLE_NAME"

  if ! aws iam get-role --role-name "$ROLE_NAME" &>/dev/null; then
    msg INFO "Role '$ROLE_NAME' does not exist — nothing to delete"
    return 0
  fi

  # Remove attached managed policies.
  while IFS= read -r policy_arn; do
    [[ -z "$policy_arn" ]] && continue
    aws iam detach-role-policy \
      --role-name "$ROLE_NAME" \
      --policy-arn "$policy_arn"
    [[ "${VERBOSE:-false}" == true ]] && msg DEBUG "Detached: $policy_arn"
  done < <(aws iam list-attached-role-policies \
    --role-name "$ROLE_NAME" \
    --query 'AttachedPolicies[].PolicyArn' \
    --output text 2>/dev/null |
    tr '\t' '\n')

  # Remove inline policies.
  while IFS= read -r inline_name; do
    [[ -z "$inline_name" ]] && continue
    aws iam delete-role-policy \
      --role-name "$ROLE_NAME" \
      --policy-name "$inline_name"
    [[ "${VERBOSE:-false}" == true ]] && msg DEBUG "Removed inline policy: $inline_name"
  done < <(aws iam list-role-policies \
    --role-name "$ROLE_NAME" \
    --query 'PolicyNames[]' \
    --output text 2>/dev/null |
    tr '\t' '\n')

  # Remove instance profile associations.
  while IFS= read -r profile; do
    [[ -z "$profile" ]] && continue
    aws iam remove-role-from-instance-profile \
      --instance-profile-name "$profile" \
      --role-name "$ROLE_NAME"
    [[ "${VERBOSE:-false}" == true ]] && msg DEBUG "Removed from instance profile: $profile"
  done < <(aws iam list-instance-profiles-for-role \
    --role-name "$ROLE_NAME" \
    --query 'InstanceProfiles[].InstanceProfileName' \
    --output text 2>/dev/null |
    tr '\t' '\n')

  aws iam delete-role --role-name "$ROLE_NAME"

  msg SUCCESS "Role deleted: $ROLE_NAME"
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------
main() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --up | --down)
      ACTION="$1"
      shift
      ;;
    --role-name)
      ROLE_NAME="$2"
      shift 2
      ;;
    --policy-name)
      POLICY_NAME="$2"
      shift 2
      ;;
    --trust-policy)
      TRUST_POLICY_FILE="$2"
      shift 2
      ;;
    --aws-account-id)
      AWS_ACCOUNT_ID="$2"
      shift 2
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      ;;
    *)
      msg ERROR "Unknown option: $1"
      usage
      ;;
    esac
  done

  require_variable ROLE_NAME
  require_variable AWS_ACCOUNT_ID

  case "${ACTION:-}" in
  --up)
    require_variable POLICY_NAME
    require_variable TRUST_POLICY_FILE
    create_role
    ;;
  --down)
    delete_role
    ;;
  *)
    msg ERROR "Action required: --up or --down"
    usage
    ;;
  esac
}

# ---------------------------------------------------------------------------
# Bootstrap
# ---------------------------------------------------------------------------
if [[ -s "${LIB_DIR}/common" ]]; then
  # shellcheck disable=SC1091
  . "${LIB_DIR}/common"
else
  echo "[ERROR] Missing: ${LIB_DIR}/common" >&2
  exit 1
fi
load_script "${LIB_DIR}/logger"

trap 'msg ERROR "Unexpected error at line $LINENO: $BASH_COMMAND"' ERR

main "$@"
