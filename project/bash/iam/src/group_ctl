#!/usr/bin/env bash
# =========================================
# FILE
#   iam/src/group_ctl
#
# SYNOPSIS
#   AWS IAM group lifecycle management.
#
# DESCRIPTION
#   Creates, configures, and deletes AWS IAM groups with
#   managed policy attachments.
#
#   Implements group-based access management following
#   AWS IAM best practices: users inherit permissions through
#   groups rather than direct policy attachments.
#
#   Lifecycle operations:
#     --up    Create the group (idempotent) and attach a managed
#             policy if not already attached.
#     --down  Detach all managed policies, remove all group
#             members, then delete the group.
#
# USAGE
#   ./group_ctl --up   --group-name <name> --policy-name <name> [OPTIONS]
#   ./group_ctl --down --group-name <name> [OPTIONS]
#
# OPTIONS
#   --up | --down            Lifecycle action (required).
#   --group-name  <name>     IAM group name (required).
#   --policy-name <name>     Managed policy name to attach (--up only).
#   --aws-account-id <id>    AWS account ID (required).
#   -v, --verbose            Enable verbose output.
#   -h, --help               Show this help.
#
# EXAMPLES
#   Create a group with policy:
#     ./group_ctl --up \
#       --group-name  DevGroup \
#       --policy-name DevPolicy \
#       --aws-account-id 123456789012
#
#   Delete a group:
#     ./group_ctl --down \
#       --group-name DevGroup \
#       --aws-account-id 123456789012
#
# DEPENDENCIES
#   AWS CLI v2
#
# REQUIRED IAM PERMISSIONS
#   iam:CreateGroup     iam:GetGroup        iam:DeleteGroup
#   iam:AttachGroupPolicy  iam:DetachGroupPolicy
#   iam:ListAttachedGroupPolicies
#   iam:RemoveUserFromGroup
#
# EXIT CODES
#   0   Success
#   1   Error
#
# NOTES
#   Project     : aws-iam-monitor
#   Version     : 2.0
#   Author      : @ZouariOmar (zouariomar20@gmail.com)
#   Created     : 20/07/2026
#   Updated     : 03/08/2026
#
# shellcheck disable=SC1090,SC1091
# =========================================
set -Eeuo pipefail

#####################
### CONFIGURATION ###
#####################

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${LIB_DIR:-${SCRIPT_DIR}/../../lib}"

GROUP_NAME=""
POLICY_NAME=""
AWS_ACCOUNT_ID=""
ACTION=""
VERBOSE="${VERBOSE:-false}"

######################
### !CONFIGURATION ###
######################

usage() {
  cat <<EOF
$(msg "USAGE:")

  $(basename "$0") --up   --group-name <name> --policy-name <name> [OPTIONS]
  $(basename "$0") --down --group-name <name> [OPTIONS]


$(msg "ACTIONS:")

  --up
      Create an IAM group and attach a managed policy.
      Idempotent: skips existing resources.

  --down
      Detach policies, remove all members, and delete the group.


$(msg "OPTIONS:")

  --group-name  <name>     IAM group name.
  --policy-name <name>     Managed policy name to attach (--up only).
  --aws-account-id <id>    AWS account ID.
  -v, --verbose            Enable verbose output.
  -h, --help               Show this help.


$(msg "EXAMPLES:")

  Create a group:
    $(basename "$0") --up \\
      --group-name  DevGroup \\
      --policy-name DevPolicy \\
      --aws-account-id 123456789012

  Delete a group:
    $(basename "$0") --down \\
      --group-name DevGroup \\
      --aws-account-id 123456789012
EOF
  exit 1
}

# ---------------------------------------------------------------------------
# create_group
# ---------------------------------------------------------------------------
create_group() {
  local policy_arn
  policy_arn=$(build_arn iam "" "$AWS_ACCOUNT_ID" "policy/${POLICY_NAME}")

  msg INFO "Creating group: $GROUP_NAME"
  [[ "${VERBOSE:-false}" == true ]] && msg DEBUG "Policy ARN: $policy_arn"

  if ! aws iam get-group --group-name "$GROUP_NAME" &>/dev/null; then
    local err
    if ! err=$(aws iam create-group --group-name "$GROUP_NAME" --output json 2>&1); then
      msg ERROR "Failed to create group '$GROUP_NAME'"
      [[ "${VERBOSE:-false}" == true ]] && msg DEBUG "$err"
      exit 1
    fi
    msg SUCCESS "Group created: $GROUP_NAME"
  else
    msg INFO "Group already exists: $GROUP_NAME"
  fi

  # Attach policy only if not already attached.
  local attached
  attached=$(aws iam list-attached-group-policies \
    --group-name "$GROUP_NAME" \
    --query "AttachedPolicies[?PolicyArn=='${policy_arn}'].PolicyArn" \
    --output text 2>/dev/null)

  if [[ -z "$attached" ]]; then
    local err
    if ! err=$(aws iam attach-group-policy \
      --group-name "$GROUP_NAME" \
      --policy-arn "$policy_arn" 2>&1); then
      msg ERROR "Failed to attach policy '$POLICY_NAME' to group '$GROUP_NAME'"
      [[ "${VERBOSE:-false}" == true ]] && msg DEBUG "$err"
      exit 1
    fi
    msg SUCCESS "Attached policy '$POLICY_NAME' to group '$GROUP_NAME'"
  else
    msg INFO "Policy '$POLICY_NAME' already attached to '$GROUP_NAME'"
  fi
}

# ---------------------------------------------------------------------------
# delete_group
# ---------------------------------------------------------------------------
delete_group() {
  msg INFO "Deleting group: $GROUP_NAME"

  if ! aws iam get-group --group-name "$GROUP_NAME" &>/dev/null; then
    msg INFO "Group '$GROUP_NAME' does not exist — nothing to delete"
    return 0
  fi

  # Detach all managed policies.
  while IFS= read -r policy_arn; do
    [[ -z "$policy_arn" ]] && continue
    aws iam detach-group-policy \
      --group-name "$GROUP_NAME" \
      --policy-arn "$policy_arn"
    [[ "${VERBOSE:-false}" == true ]] && msg DEBUG "Detached: $policy_arn"
  done < <(aws iam list-attached-group-policies \
    --group-name "$GROUP_NAME" \
    --query 'AttachedPolicies[].PolicyArn' \
    --output text 2>/dev/null |
    tr '\t' '\n')

  # Remove all members.
  while IFS= read -r user; do
    [[ -z "$user" ]] && continue
    aws iam remove-user-from-group \
      --group-name "$GROUP_NAME" \
      --user-name "$user"
    [[ "${VERBOSE:-false}" == true ]] && msg DEBUG "Removed user from group: $user"
  done < <(aws iam get-group \
    --group-name "$GROUP_NAME" \
    --query 'Users[].UserName' \
    --output text 2>/dev/null |
    tr '\t' '\n')

  aws iam delete-group --group-name "$GROUP_NAME"

  msg SUCCESS "Group deleted: $GROUP_NAME"
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------
main() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --up | --down)
      ACTION="$1"
      shift
      ;;
    --group-name)
      GROUP_NAME="$2"
      shift 2
      ;;
    --policy-name)
      POLICY_NAME="$2"
      shift 2
      ;;
    --aws-account-id)
      AWS_ACCOUNT_ID="$2"
      shift 2
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      ;;
    *)
      msg ERROR "Unknown option: $1"
      usage
      ;;
    esac
  done

  require_variable GROUP_NAME
  require_variable AWS_ACCOUNT_ID

  case "${ACTION:-}" in
  --up)
    require_variable POLICY_NAME
    create_group
    ;;
  --down)
    delete_group
    ;;
  *)
    msg ERROR "Action required: --up or --down"
    usage
    ;;
  esac
}

# ---------------------------------------------------------------------------
# Bootstrap
# ---------------------------------------------------------------------------
if [[ -s "${LIB_DIR}/common" ]]; then
  # shellcheck disable=SC1091
  . "${LIB_DIR}/common"
else
  echo "[ERROR] Missing: ${LIB_DIR}/common" >&2
  exit 1
fi
load_script "${LIB_DIR}/logger"

trap 'msg ERROR "Unexpected error at line $LINENO: $BASH_COMMAND"' ERR

main "$@"
